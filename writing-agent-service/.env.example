ENVIRONMENT=production

# 数据库连接
DATABASE_URL=postgresql+psycopg://writing_user:password@postgres:5432/writing_agent
REDIS_URL=redis://redis:6379/0
PROGRESS_STREAM_PREFIX=news-writing:events
PROGRESS_STREAM_MAXLEN=2000
PROGRESS_DEDUP_TTL_SECONDS=86400
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_POLL_INTERVAL_SECONDS=1.0
SSE_BLOCK_MS=15000
SSE_BATCH_SIZE=100
SSE_RETRY_MS=5000

# 队列
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=news-writing
TEMPORAL_TASK_QUEUE=news-writing

# FastGPT连接服务
FASTGPT_BASE_URL=http://fastgpt:3000
FASTGPT_API_KEY=replace-with-secret
FASTGPT_DATASET_ID=replace-with-dataset-id
FASTGPT_RESEARCH_APP_ID=replace-with-app-id
FASTGPT_WRITER_APP_ID=replace-with-app-id
FASTGPT_REVIEWER_APP_ID=replace-with-app-id
FASTGPT_SUPERVISOR_APP_ID=

# 文章存储
ARTIFACT_BUCKET=news-writing-artifacts
ARTIFACT_ENDPOINT=http://minio:9000
ARTIFACT_REGION=us-east-1
ARTIFACT_PREFIX=news-writing
ARTIFACT_SSE_ALGORITHM=AES256
# 使用云厂商 KMS 时改为 aws:kms，并通过 Secret 注入真实 Key ID
ARTIFACT_KMS_KEY_ID=
