ENVIRONMENT=production

# 数据库连接
DATABASE_URL=postgresql+psycopg://writing_user:password@postgres:5432/writing_agent
REDIS_URL=redis://redis:6379/0
PROGRESS_STREAM_PREFIX=news-writing:events
PROGRESS_STREAM_MAXLEN=2000
PROGRESS_DEDUP_TTL_SECONDS=86400
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_POLL_INTERVAL_SECONDS=1.0
SSE_BLOCK_MS=15000
SSE_BATCH_SIZE=100
SSE_RETRY_MS=5000

# 队列
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=news-writing
TEMPORAL_HOT_NEWS_TASK_QUEUE=hot-news
TEMPORAL_DATA_LOOP_TASK_QUEUE=hot-news-data-loop

# FastGPT连接服务
FASTGPT_BASE_URL=http://fastgpt:3000
FASTGPT_API_KEY=replace-with-secret
FASTGPT_DATASET_ID=replace-with-dataset-id
FASTGPT_RESEARCH_APP_ID=replace-with-app-id
FASTGPT_WRITER_APP_ID=replace-with-app-id
FASTGPT_REVIEWER_APP_ID=replace-with-app-id
FASTGPT_HOT_NEWS_APP_ID=replace-with-app-id
FASTGPT_ERROR_ATTRIBUTION_APP_ID=
# 必须是至少一个完整 ProductionBundleSpec 的 JSON 数组；空数组会让 Worker/API fail-closed。
HOT_NEWS_RUNTIME_MANIFEST_JSON=[]
# 热点监控 Temporal Schedule 定义，每个租户组一个 Schedule；
# 空数组表示不做周期调度。示例：
# [{"tenant_group":"default","tenant_id":"<uuid>","production_bundle_version":"bundle-1","window_minutes":60,"interval_minutes":60}]
HOT_NEWS_SCHEDULE_DEFINITIONS_JSON=[]
DATA_LOOP_REPLAY_MAX_CONCURRENCY=8
DATA_LOOP_MAX_CASES_PER_COHORT=20
# Data Loop 管理 API 与热点控制台 API 共用的可信网关 Bearer 密钥；
# 两个模块复用同一共享凭据，但角色头各自独立（X-Data-Loop-Roles /
# X-Hot-News-Roles）。生产环境必须由 Secret 注入。
DATA_LOOP_GATEWAY_TOKEN=replace-with-a-long-random-gateway-secret
FASTGPT_SUPERVISOR_APP_ID=

# CMS 发布网关。企业 CMS 未接入前可指向 deploy/mock-cms（本地 uvicorn
# 或 compose 的 mock-cms 服务）；生产必须替换为企业真实 CMS 网关地址。
CMS_PUBLISH_URL=
CMS_PUBLISH_TOKEN=
CMS_PUBLISH_TIMEOUT_SECONDS=30

# 视频内容入库（默认关闭；未开启或缺少地址/凭据时装配会 fail-closed，不会发起模型调用）
VIDEO_INGEST_ENABLED=false
VIDEO_UNDERSTANDING_ENABLED=true
VIDEO_MODEL_BASE_URL=
VIDEO_MODEL_API_KEY=
VIDEO_MODEL_ROUTE=hunyuan-turbos-vision-video-20250728
# 抽帧率是成本与粒度总开关：越低越省 token，产出越接近概览级摘要
VIDEO_SUMMARY_FPS=1.0
VIDEO_SUMMARY_MAX_OUTPUT_CHARS=600
# 画面概括与语音转写默认二选一（优先语音），置 true 才叠加两者，费用也翻倍
VIDEO_FUSE_VISUAL_SUMMARY=false

# 语音转写（ASR）：视频的"说了什么"。需凭据，生产由 Secret 注入。
# 通道选择：腾讯云「录音文件识别」（CreateRecTask）可直接传 mp4 地址，
# 服务端自行抽音轨（音频白名单含 mp4/flv/m4a；URL 方式 ≤5 小时、≤1GB）。
# 注意：混元 ASR（Hy-ASR-3.0-preview）当前内测版仅支持实时、单次 1 分钟以内，
# 且只吃 16k 单声道 PCM，不适合直接处理完整新闻视频。
VIDEO_ASR_ENABLED=false
VIDEO_ASR_ROUTE=tencent-asr-16k-zh-en
VIDEO_ASR_LANGUAGE=zh
# 热词是 JSON 数组，用于提升专有名词识别率，例如 ["寒潮","气象局"]
# 官方限制：单热词 ≤30 字符、最多 128 个（本地会先校验再提交）
VIDEO_ASR_HOTWORDS=[]
# 鉴权形态：tc3=公网云 API 密钥；gateway=内网网关注入头；none=内网免签
# 腾讯内部接入通常用 gateway / none，并把 VIDEO_ASR_ENDPOINT 换成内网域名
VIDEO_ASR_AUTH_MODE=tc3
VIDEO_ASR_SECRET_ID=
VIDEO_ASR_SECRET_KEY=
VIDEO_ASR_REGION=
VIDEO_ASR_ENDPOINT=
# 仅 gateway 模式使用，JSON 对象；生产由 Secret 注入，不要写进仓库
VIDEO_ASR_GATEWAY_HEADERS={}
# 配置后走回调模式，生产可省掉轮询
VIDEO_ASR_CALLBACK_URL=
# 扩展名不在官方白名单时直接拒绝（企业内网无后缀地址仍放行）
VIDEO_ASR_STRICT_MEDIA_FORMAT=true
# 便捷入口的轮询参数；生产建议改用提交/查询两段式编排
VIDEO_ASR_POLL_INTERVAL_SECONDS=3.0
VIDEO_ASR_MAX_POLL_ATTEMPTS=100
VIDEO_ASR_TIMEOUT_MS=120000

VIDEO_TEXT_POLICY_VERSION=video-text-v2
VIDEO_TEXT_MIN_CHARS=40
VIDEO_INGEST_SKIP_INSUFFICIENT=true

# 文章存储
ARTIFACT_BUCKET=news-writing-artifacts
ARTIFACT_ENDPOINT=http://minio:9000
ARTIFACT_REGION=us-east-1
ARTIFACT_PREFIX=news-writing
ARTIFACT_SSE_ALGORITHM=AES256
# 使用云厂商 KMS 时改为 aws:kms，并通过 Secret 注入真实 Key ID
ARTIFACT_KMS_KEY_ID=
