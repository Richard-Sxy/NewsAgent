WRITING_DB_USER=writing_user
WRITING_DB_PASSWORD=replace-with-a-long-random-password
WRITING_DB_NAME=writing_agent

TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=replace-with-a-long-random-password

# Existing FastGPT development stack credentials.
FASTGPT_REDIS_PASSWORD=replace-with-existing-redis-password
MINIO_ACCESS_KEY=replace-with-existing-minio-access-key
MINIO_SECRET_KEY=replace-with-existing-minio-secret-key
ARTIFACT_BUCKET=news-writing-artifacts

# Create these after FastGPT main application is reachable.
FASTGPT_API_KEY=replace-after-fastgpt-app-setup
FASTGPT_RESEARCH_APP_ID=replace-after-fastgpt-app-setup
FASTGPT_WRITER_APP_ID=replace-after-fastgpt-app-setup
FASTGPT_REVIEWER_APP_ID=replace-after-fastgpt-app-setup

# Optional enterprise CMS gateway. Keep unset until the target endpoint is ready.
CMS_PUBLISH_URL=
CMS_PUBLISH_TOKEN=
CMS_PUBLISH_TIMEOUT_SECONDS=30

# Container ceilings; tune from production telemetry.
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1G
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2G
OUTBOX_CPU_LIMIT=0.5
OUTBOX_MEMORY_LIMIT=512M
