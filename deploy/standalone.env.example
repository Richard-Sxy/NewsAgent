# Copy to a private env file and replace every placeholder before starting.
WRITING_DB_USER=writing_user
WRITING_DB_PASSWORD=replace-with-a-long-random-password
WRITING_DB_NAME=writing_agent
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=replace-with-a-long-random-password

# The model endpoints and approved model routes live in model-runtime.enterprise.yml.
# The values below are injected by the deployment secret manager.
ENTERPRISE_MODEL_API_KEY=replace-with-enterprise-inference-key
ENTERPRISE_EMBEDDING_API_KEY=replace-with-enterprise-embedding-key

MINIO_ACCESS_KEY=replace-with-local-minio-user
MINIO_SECRET_KEY=replace-with-a-long-random-password
ARTIFACT_BUCKET=news-writing-artifacts
DATA_LOOP_GATEWAY_TOKEN=replace-with-a-long-random-token
# 可选：将冻结案例所引用的完整 run 交给隔离分析服务；无部署时保持 false。
DATA_LOOP_DATA_ANALYSIS_ENABLED=false
DATA_ANALYSIS_BACKEND=service
DATA_ANALYSIS_SERVICE_URL=https://analysis.example.internal
DATA_ANALYSIS_SERVICE_TOKEN=replace-with-a-long-random-analysis-secret
DATA_ANALYSIS_MAX_ROWS=200
KNOWLEDGE_INGEST_TOKEN=replace-with-a-long-random-knowledge-token

# Required only when enabling the hot-news or data-loop profiles.
HOT_NEWS_DEPENDENCIES_FACTORY=
HOT_NEWS_RUNTIME_MANIFEST_JSON=[]
HOT_NEWS_SCHEDULE_DEFINITIONS_JSON=[]
