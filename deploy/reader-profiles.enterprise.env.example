# Non-secret template. Inject the token via the enterprise secret manager.
READER_PROFILE_ENABLED=true
READER_PROFILE_BACKEND=enterprise_http
READER_PROFILE_ENDPOINT_URL=https://reader-aggregates.internal.example/v1/query
READER_PROFILE_API_TOKEN=
READER_PROFILE_TAXONOMY_PATH=/etc/newsagent/approved-topics.yml
# REQUIRED: SHA256 of an immutable, enterprise-approved aggregate release.
READER_PROFILE_SOURCE_RELEASE_SHA256=
READER_PROFILE_POLICY_VERSION=prewindow-exclude-trigger-interest-v1
# Register this Prompt asset in the enterprise model runtime and approved Bundle.
READER_PROFILE_ALLOWED_ANALYSIS_PROMPT_VERSIONS=["enterprise-reader-analysis-v1"]
READER_PROFILE_TIMEOUT_SECONDS=3
READER_PROFILE_RUN_TIMEOUT_SECONDS=5
READER_PROFILE_CACHE_TTL_SECONDS=30
READER_PROFILE_MAX_CACHE_ENTRIES=256
READER_PROFILE_MAX_INFLIGHT=16
READER_PROFILE_MAX_RESPONSE_BYTES=524288
