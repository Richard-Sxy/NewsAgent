# 普通配置，可提交版本库；所有密码、Token、含密码的 DSN 放 Secret。
# 企业地址以 example.invalid 占位，填写后再部署。不要在此保存用户行为明细。
ENVIRONMENT=production
MODEL_RUNTIME_BACKEND=native
MODEL_RUNTIME_CONFIG_PATH=/etc/newsagent/runtime/model-runtime.yml
KNOWLEDGE_SEARCH_CONFIG_PATH=/etc/newsagent/runtime/knowledge-search.yml
TEMPORAL_ADDRESS=temporal.example.invalid:7233
TEMPORAL_NAMESPACE=newsagent-production
TEMPORAL_TASK_QUEUE=news-writing
TEMPORAL_HOT_NEWS_TASK_QUEUE=hot-news
TEMPORAL_DATA_LOOP_TASK_QUEUE=hot-news-data-loop
ARTIFACT_ENDPOINT=https://s3.example.invalid
ARTIFACT_REGION=replace-me
ARTIFACT_BUCKET=replace-me
ARTIFACT_PREFIX=newsagent/production
ARTIFACT_SSE_ALGORITHM=AES256
AWS_EC2_METADATA_DISABLED=true
# CMS_PUBLISH_URL 故意不配置；未完成企业 CMS 联调前，发布保持关闭。
CMS_PUBLISH_TIMEOUT_SECONDS=30
# 首次部署只上线服务骨架，按模块完成鉴权与业务验收后显式开启。
CONVERSATION_ENABLED=false
CONVERSATION_KNOWLEDGE_ENABLED=false
CONVERSATION_HOT_NEWS_QUERY_ENABLED=false
CONVERSATION_ASYNC_ADMISSION_ENABLED=false
CONVERSATION_DATA_ANALYSIS_ENABLED=false
DATA_LOOP_DATA_ANALYSIS_ENABLED=false
HOT_NEWS_RUNTIME_MANIFEST_JSON=[]
HOT_NEWS_SCHEDULE_DEFINITIONS_JSON=[]
HOT_NEWS_ANALYSIS_MAX_CONCURRENCY=1
DATA_LOOP_REPLAY_MAX_CONCURRENCY=2
# 企业 SDK/工厂打包进镜像后再添加 HOT_NEWS_DEPENDENCIES_FACTORY=package.module:factory。
