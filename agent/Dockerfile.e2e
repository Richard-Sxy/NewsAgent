# Keep the readable tag, but pin its multi-platform manifest digest. Update the
# tag and digest together through an explicit dependency-maintenance change.
FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

ARG APP_EXTRAS=""

# hnswlib builds a C++ extension on the slim Python image. Keep its build
# dependency conditional so the default lightweight E2E image is unchanged.
RUN case "${APP_EXTRAS}" in *bge-snapshot*) \
      apt-get update \
      && apt-get install -y --no-install-recommends g++ \
      && rm -rf /var/lib/apt/lists/* ;; \
    esac

RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app app \
    && mkdir -p /state \
    && chown app:app /state

COPY agent/pyproject.toml ./
COPY agent/app ./app

# Install the application and dependencies before copying test-only assets, so
# editing a runbook fixture or E2E test does not force a full dependency fetch.
# The local BGE demo runs on CPU. Install its reviewed CPU wheel first so the
# general package index cannot select a CUDA-enabled PyTorch distribution.
RUN pip install --upgrade pip \
    && case "${APP_EXTRAS}" in *bge-snapshot*) \
         pip install 'torch==2.8.0+cpu' --index-url https://download.pytorch.org/whl/cpu ;; \
       esac \
    && pip install ".[dev${APP_EXTRAS}]"

COPY agent/alembic ./alembic
COPY agent/alembic.ini ./
COPY agent/examples ./examples
COPY agent/simulation ./simulation
COPY agent/tools/collect_public_headlines.py ./tools/collect_public_headlines.py
COPY agent/tools/seed_conversation_evaluation_demo.py ./tools/seed_conversation_evaluation_demo.py
COPY agent/tools/conversation_hooks_load.py ./tools/conversation_hooks_load.py
COPY agent/tools/query_news_recall.py ./tools/query_news_recall.py
COPY agent/evaluation ./evaluation
COPY deploy/mock-cms ./deploy/mock-cms
COPY deploy/model-runtime.local.yml ./deploy/model-runtime.local.yml
COPY deploy/model-runtime.reader-profiles.local.yml ./deploy/model-runtime.reader-profiles.local.yml
COPY deploy/model-runtime.enterprise.example.yml ./deploy/model-runtime.enterprise.example.yml
COPY deploy/model-runtime.compatible.example.yml ./deploy/model-runtime.compatible.example.yml
COPY deploy/knowledge-search.bge-snapshot.yml ./deploy/knowledge-search.bge-snapshot.yml
COPY deploy/docker-compose.compatible-model.example.yml ./deploy/docker-compose.compatible-model.example.yml
COPY deploy/text2sql-scenes.local.yml ./deploy/text2sql-scenes.local.yml
COPY deploy/text2sql-scenes.real-news-v8.yml ./deploy/text2sql-scenes.real-news-v8.yml
COPY deploy/text2sql-scenes.example.yml ./deploy/text2sql-scenes.example.yml
COPY deploy/audience-topics.local.yml ./deploy/audience-topics.local.yml
COPY deploy/audience-topics.enterprise.example.yml ./deploy/audience-topics.enterprise.example.yml
COPY deploy/docker-compose.audience.local.yml ./deploy/docker-compose.audience.local.yml
COPY deploy/behavior-topic-policy.local.yml ./deploy/behavior-topic-policy.local.yml
COPY deploy/docker-compose.behavior-tags.local.yml ./deploy/docker-compose.behavior-tags.local.yml
COPY deploy/text2sql-scenes.enterprise-v2.yml ./deploy/text2sql-scenes.enterprise-v2.yml
COPY deploy/text2sql-scenes.public-headlines-v3.yml ./deploy/text2sql-scenes.public-headlines-v3.yml
COPY agent/docs/sql-warehouse/ ./docs/sql-warehouse/
COPY deploy/text2sql-scenes.timeline-v4.yml ./deploy/text2sql-scenes.timeline-v4.yml
COPY agent/data/public-headlines/2026-10-07/catalog.json ./data/public-headlines/2026-10-07/catalog.json
COPY agent/tests ./tests

USER 10001:10001

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
