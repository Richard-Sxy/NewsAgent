# Official distribution registries bypass a broken Docker Hub mirror. Pin the
# multi-platform manifests so both arm64 and amd64 use the reviewed releases.
FROM public.ecr.aws/docker/library/node:22.12-alpine@sha256:51eff88af6dff26f59316b6e356188ffa2c422bd3c3b76f2556a2e7e89d080bd AS build

WORKDIR /app
ENV CI=true \
    npm_config_audit=false \
    npm_config_fund=false

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY tsconfig.json vite.config.ts index.html ./
# Vite imports this Node-only module even for production builds. Its local YAML
# and all identity/secret environment files are excluded from this build context.
COPY dev-server/local-config.mjs ./dev-server/local-config.mjs
COPY dev-server/local-config.d.mts ./dev-server/local-config.d.mts
COPY public ./public
COPY src ./src
RUN npm run build

FROM ghcr.io/nginx/nginx-unprivileged:1.27-alpine@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0 AS runtime

# Base image runs as uid 101 and listens on 8080. Compose mounts the local demo
# gateway and runtime JSON read-only; the image itself has the normal gateway.
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
