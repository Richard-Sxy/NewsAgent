# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
.venv-*/
venv/

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Build output
dist/
build/

# Local FastGPT files retained after removing the vendored upstream source.
# Includes generated dependencies and private local deployment configuration.
/FastGPT-local-backup/

# IDE / OS
.idea/
.vscode/
.DS_Store
.workbuddy/

# User-approved endpoint configuration; credentials still belong in injected env.
/agent/deploy/model-runtime.compatible.yml
/deploy/model-runtime.compatible.yml

# rag
rag-recall-demo/
tmp/

# Generated local BGE packages contain model weights and rebuildable vectors.
# Includes leading-dot working/interrupted build dirs.
/agent/data/news-bge-incremental-*/
/agent/data/.news-bge-incremental-*/

# Generated warehouse data packages; keep small contract/manifest files
# (schema.sql, validation.json, scenarios.json, catalog.json, preview.json).
/output/warehouse/**/*.jsonl
/output/warehouse/**/warehouse.sql

# Crawler-generated incremental article cache; rebuildable from crawling.
/news/data/incremental/

# Local run packages under var/ (rebuildable bulk data; manifests/contracts stay tracked).
/var/behavior-tags/**/*.jsonl
/var/behavior-tags/**/*.sqlite
/var/behavior-tags/.*.building-*/
/var/reader-profiles/**/*.sqlite
/var/reader-profiles/.*.building-*/
/var/warehouse/**/*.jsonl
/var/warehouse/**/warehouse.sql
/var/knowledge-snapshots/
/var/backups/news-category-prune-20261025/

# Rebuildable local synthetic behavior packages; keep small manifests/reports.
/output/behavior-tags/**/label_index.sqlite
/output/behavior-tags/**/*.jsonl
/output/behavior-tags/.*.building-*/

# Rebuildable news-reader aggregates; retain manifests and scoring policies.
/output/reader-profiles/**/*.sqlite
/output/reader-profiles/.*.building-*/

# Migrated bulk run packages under the data root (rebuildable; catalogs stay tracked).
/var/agent/data/news-bge-incremental-*/
/var/agent/data/.news-bge-incremental-*/
/var/news/data/incremental/

# Derived extension metadata for the v8 package; the canonical copy lives in agent/data/.
/var/warehouse/**/catalog-extension-*.json

# Generated real-news extension metadata; local-only and derived from ignored caches.
/agent/data/real-news-warehouse-v8/catalog-extension-*.json

# Frozen public-news source material. Keep small manifests, not captured bodies.
/var/news-storage/**/*.jsonl
/var/news-storage/.*.building-*/

# Local Hunyuan weights, runtime logs and experimental adapters (rebuildable).
/var/models/
/var/hunyuan/

# Local observability recovery archives contain bulk runtime storage.
/var/observability-backup-*/
# Full local soak evidence stays available on disk; compact summaries are tracked.
/output/governance-*/soak*.json
/output/governance-*/*.samples.jsonl

# Unified small-model workspace: large/private/generated assets stay local.
/small_model/models/
/small_model/environments/
/small_model/runtime/
/small_model/adapters/*
!/small_model/adapters/README.md
/small_model/training/*/
/small_model/runs/*
!/small_model/runs/README.md
# Renamed Hunyuan workspace uses the same local-only asset boundaries.
/Hunyuan7B/models/
/Hunyuan7B/environments/
/Hunyuan7B/runtime/
/Hunyuan7B/adapters/*
!/Hunyuan7B/adapters/README.md
/Hunyuan7B/training/*/
/Hunyuan7B/runs/*
!/Hunyuan7B/runs/README.md
# Compatibility aliases to ignored assets (symlinks are not directory patterns).
/.venv-hunyuan
/var/hunyuan
/var/query-eval

# Explicit synthetic annual-scale workload; regenerate from tracked profile and seed.
/var/news-capacity-20261027/

# Live human editing events; export a consistent reviewed snapshot separately.
/output/resume-quality-20261028/text-final-v3/manual-editing-state/
