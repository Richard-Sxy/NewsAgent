-82c4-be357b54fe9b.png', 'daytime_url': 'https://new.inews.gtimg.com/tnews/45af77fe/a73d/45af77fe-a73d-42d2-ab80-feaa383611de.png'}}, 'interation_info': {'comment_id': '1260820604919613', 'commet_num': 68, 'read_num': 67590, 'like_num': 133, 'collect_num': 95, 'share_num': 67, 'share_wechat_num': 56}, 'doc_info': {'first_cate_id': '19', 'first_cate_name': 'auto', 'sec_cate_id': '1901', 'sec_cate_name': 'auto_chanye'}, 'short_title': '前一款车拿下合资电车销冠，后一款就销量腰斩，日系合资品牌问题在哪', 'update_time': '2026-08-20 20:30:06', 'news724_feature': None, 'desc': '文｜Grace      编辑｜杨布丁      “铂智3X是从0到1，证明合资也能做好电车；铂智7是从1到10，核心是形成一套方法论。”这是今年3月广汽丰田执行副总经理文大力在铂智7上市时的表态。....', 'safe_control': {'close_all_ad': 0, 'close_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '汽车', 'cate1_en_name': 'car', 'cate1_id': '60037744', 'cate2_name': '行业资讯', 'cate2_id': '21595110'}, 'declare': {}, 'pub_info': {'source': '6', 'sub_source': '121'}, 'payment_info': {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': 4}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '铂智3X登顶合资电车销冠，铂智7销量腰斩，丰田在华高端电车梦受阻', 'share_subtitle': '文｜Grace      编辑｜杨布丁      “铂智3X是从0到1，证明合资也能做好电车；铂智7是从1到10，核心是形成一套方法论。”这是今年3月广汽丰田执行副总经理文大力在铂智7上市时的表态。....'}, 'long_summary': '从实际表现来看，7月铂智3X依然蝉联合资新能源销冠，也是国内新能源SUV销量TOP20中唯一一款合资车；但铂智7上市五个月，销量从4637辆跌至2108辆，已几近腰斩。铂智3X能率先跑出来，核心逻辑在于它没有简单照搬“丰田技术+丰田品牌”的传统路径，走出了一条“全球标准+现地共创”的新路径。出口也在铂智的规划中，2025年10月铂智3X以22.96万港元的售价在香港上市，这是丰田合资企业首次进入丰田全球销售体系，在中国内地以外的市场销售的整车产品，未来铂智的产品还将进一步反哺全球市场。'}, {'id': 'UTR2026081307354400', 'articletype': '116', 'title': '2026成都车展新车探秘：新车看哪些？', 'pic_style': 0, 'publish_time': '2026-08-20 20:23:00', 'pic_info': {'big_img': ['https://inews.gti