ms': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '1换2交易达成！掘金正式解体！约基奇离队倒计时', 'share_subtitle': '北京时间8月20日，掘金将佩顿-沃特森送到骑士，换来1个首轮签和1个次轮签。美媒DraftKings Sports晒图并写道，掘金2023年夺冠阵容当中，已经有10人离队。目前掘金仅剩5名冠军成员：....'}, 'long_summary': '北京时间8月20日，掘金将佩顿-沃特森送到骑士，换来1个首轮签和1个次轮签。美媒DraftKings Sports晒图并写道，掘金2023年夺冠阵容当中，已经有10人离队。目前掘金仅剩5名冠军成员：约基奇、穆雷、戈登、布劳恩、纳吉。来看看离队的10人：伊斯梅尔-史密斯已经退役，成了奇才球探。今天沃特森和骑士签下4年8800万美元的大合同，布劳恩第一时间更新社交媒体：不少球迷表示，如果不是布劳恩那份5年1.25亿的大合同，沃特森可能不会离队。掘金也想续约沃特森，但真的掏不起奢侈税。', 'declares': [{'type': 'self_declare', 'text': '作者声明：个人观点，仅供参考', 'self_declare_id': 2}]}, {'id': '20260819V0D5M500', 'articletype': '4', 'title': '半决赛战阿森纳！U17中国女足3-0曼城，进14球零封三连胜出线', 'pic_style': 4, 'publish_time': '2026-08-19 21:47:58', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/O9R9fuAVn6vxfaPPmgkX-X6r6YS4C3lm5zcFXqtcmUNNEAA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/O9R9fuAVn6vxfaPPmgkX-X6r6YS4C3lm5zcFXqtcmUNNEAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/O5UU8Ulqs_IScWo7VqT9VMv8eRqcDTzOfWfxt3IrQbDr0AA_150120/0'], 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/O9R9fuAVn6vxfaPPmgkX-X6r6YS4C3lm5zcFXqtcmUNNEAA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/O9R9fuAVn6vxfaPPmgkX-X6r6YS4C3lm5zcFXqtcmUNNEAA_196130/0', '330x330': 'https://inews.gtimg.com/om_ls/O9R9fuAVn6vxfaPPmgkX-X6r6YS4C3lm5zcFXqtcmUNNEAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/O4CV1SEQUU3YX1tQok9O924gNyrSxVlsIYG24xy9Fp3OkAA_240240/0', 'aspect': '1.78', 'pic_first': 'https://puui.qpic.cn/vpic_cover/b12836guf1h/b12836guf1h_first.jpg/720'}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260819V0D5M500', 'url': 'https://new.qq.com/rain/a/20260819V0D5M500', 'short_url': 'https://view.inews.qq.com/a/20260819V0D5M500', 'org_url': 'https://view.inews.qq.com/a/20260819V0D5M500'}, 'media_info': {'chl_id