flag': {}, 'extra_property': {}, 'share_info': {'share_title': '詹姆斯领衔三巨头提前合练！马克西谈最后一投：所有人必须放下自我', 'share_subtitle': '北京时间8月20日，NBA进入休赛期。根据知名记者McMenamin报道，76人队三大球星詹姆斯、杰伦-布朗与马克西齐聚洛杉矶，开启了休赛期合练，三大巨头提前磨合，为新赛季冲冠之路筑牢基础。    ....'}, 'long_summary': '北京时间8月20日，NBA进入休赛期。根据知名记者McMenamin报道，76人队三大球星詹姆斯、杰伦-布朗与马克西齐聚洛杉矶，开启了休赛期合练，三大巨头提前磨合，为新赛季冲冠之路筑牢基础。本次集训由知名训练师克里斯-约翰逊全程组织指导，训练结束后，他在个人社交媒体晒出三人并肩训练的照片。作为新赛季正式加盟76人的强援，杰伦-布朗此番与詹姆斯、马克西提前合练，是球队核心阵容磨合的重要一环。他着重强调了团队篮球的重要性，直言全队上下必须放下个人自我。'}, {'id': '20260820A0BNLS00', 'articletype': '0', 'title': '39岁梅西罕见失态！怒扇对手头部+顶牛 将被调查：恐遭罚款或停赛', 'pic_style': 0, 'publish_time': '2026-08-20 17:47:35', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OAVFCkDifOtv_vO29h7fw1Bmb1zIYAP9JGH449YcVLJCgAA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/OAVFCkDifOtv_vO29h7fw1Bmb1zIYAP9JGH449YcVLJCgAA_294195/0'], 'three_img': ['https://inews.gtimg.com/om_ls/OAVFCkDifOtv_vO29h7fw1Bmb1zIYAP9JGH449YcVLJCgAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/om_ls/OAVFCkDifOtv_vO29h7fw1Bmb1zIYAP9JGH449YcVLJCgAA_196130/0', '360x240': 'https://inews.gtimg.com/om_ls/OAVFCkDifOtv_vO29h7fw1Bmb1zIYAP9JGH449YcVLJCgAA_360240/0', '330x330': 'https://inews.gtimg.com/om_ls/OAVFCkDifOtv_vO29h7fw1Bmb1zIYAP9JGH449YcVLJCgAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/Ov6rYnGP-rhHcu8G6NSS7il-40HOaN9xV6Hy49uFJJ4NkAA_240240/0', 'img_count': 4}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260820A0BNLS00', 'url': 'https://new.qq.com/rain/a/20260820A0BNLS00', 'short_url': 'https://view.inews.qq.com/a/20260820A0BNLS00', 'org_url': 'https://view.inews.qq.com/a/20260820A0BNLS00'}, 'media_info': {'chl_id': '5015568', 'chl_name': '我爱英超', 'icon': 'http://inews.gtimg.com/newsapp_ls/0/366752267_200200/0', 'sicon': 'http://inews.gtimg.com/newsapp_ls/0/366752267_200200/0', 'mrk': '最新最权威的英超媒体号期待你的关注！', 'last_art_update': '0', 'uin': 'ec03072e55aadcb9185c2a630183de9da5', 'encoded_suid': '8QMf23tZ6oIfvDja', 'vip_type': '30011', 'vip_