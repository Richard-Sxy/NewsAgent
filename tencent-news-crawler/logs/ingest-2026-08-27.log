, 'cate1_en_name': 'car', 'cate1_id': '60037744', 'cate2_name': '行业资讯', 'cate2_id': '21595110'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '上海', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '理想汽车三季度可能仍难扭亏', 'share_subtitle': '界面新闻记者 | 武凯界面新闻编辑 | 周姝祺受市场环境、原材料价格上涨和产品迭代等多重因素影响，今年二季度理想汽车没能扭转亏损趋势。这家曾被视为最会赚钱的造车新势力，交出了上市以来亏损最严重的半年报。2026年上半年，理想汽车净亏损39.81亿元，去年同期盈利17.44亿元；毛利率由20.3%大幅下降至9.5%。在最核心的汽...'}, 'long_summary': '受市场环境、原材料价格上涨和产品迭代等多重因素影响，今年二季度理想汽车没能扭转亏损趋势。这家曾被视为最会赚钱的造车新势力，交出了上市以来亏损最严重的半年报。2026年上半年，理想汽车净亏损39.81亿元，去年同期盈利17.44亿元；毛利率由20.3%大幅下降至9.5%。和一季度低谷相比，理想汽车在二季度有所好转。但从第三季度指引来看，理想汽车想要实现该季度扭亏为盈，难度系数不低。理想汽车预计三季度交付9.5万至10万辆，低于市场预期。'}, {'id': '20260827A0BKRI00', 'articletype': '0', 'title': '小鹏要等两个黎明', 'pic_style': 0, 'publish_time': '2026-08-27 19:19:08', 'pic_info': {'big_img': ['https://inews.gtimg.com/news_ls/OH7E238dDkogSBXGI2Sm2lOe1hXLKVfarfGM9A3PbbV6MAA_870492/0'], 'small_img': ['https://inews.gtimg.com/news_ls/OH7E238dDkogSBXGI2Sm2lOe1hXLKVfarfGM9A3PbbV6MAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/OH7E238dDkogSBXGI2Sm2lOe1hXLKVfarfGM9A3PbbV6MAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/news_ls/OH7E238dDkogSBXGI2Sm2lOe1hXLKVfarfGM9A3PbbV6MAA_196130/0', '360x240': 'https://inews.gtimg.com/news_ls/OH7E238dDkogSBXGI2Sm2lOe1hXLKVfarfGM9A3PbbV6MAA_360240/0', '330x330': 'https://inews.gtimg.com/news_ls/OH7E238dDkogSBXGI2Sm2lOe1hXLKVfarfGM9A3PbbV6MAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/O484q590A4yJTvtzCEsLjnWuKedEIEb6OFSTXQVMWr6YsAA_240240/0', 'img_count': 5}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260827A0BKRI00', 'url': 'https://view.inews.qq.com/a/20260827A0BKRI00', 'short_