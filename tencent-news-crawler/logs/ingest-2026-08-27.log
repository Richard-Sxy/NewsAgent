: {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': 2}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '宝马3系5系不见踪影，成都车展大变脸，大量车企缺席', 'share_subtitle': '图源：视觉中国      作者 ｜\xa0岳家琛      编辑 ｜\xa0孙春芳      出品 ｜ 棱镜·腾讯小满工作室      8月21日至30日，第29届成都车展在西博城举行。      如果你是一位....'}, 'long_summary': '8月21日至30日，第29届成都车展在西博城举行。如果你是一位两年前曾到访过这里的观众，今年的展台布置可能会产生一种时空错乱的恍惚感。两年前，宝马展台上还是3系、5系等燃油车的天下，如今，这两款曾经的明星产品已不见踪影，取而代之的是华晨宝马最新生产的新世代纯电车型——宝马i3和iX3。本次成都车展，如同合资车企的分水岭，一部分合资车企，带着全新的新能源车型、全新面孔，高调亮相，誓与自主品牌掰一掰手腕。其中，东风日产首次缺席成都车展，东风本田、悦达起亚均没有出现在展馆中。有的仓促卸妆，黯然离场。'}, {'id': '20260708V05PMN00', 'articletype': '4', 'title': '比亚迪慌了？坦克300大改款！25.98万起售 电驱介入剑指方程豹', 'pic_style': 4, 'publish_time': '2026-08-27 13:30:53', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OBqiYIhrmLHKdxjIPqa32UVUFJpSM9D6EvFoaSX_52IvoAA_870492_compress/0'], 'small_img': ['https://inews.gtimg.com/om_ls/OX-Zkng-_mnwAVqjgvSLeujylmYDYf9ZBPGWYGRtWUuUAAA_294195_compress/0'], 'three_img': ['https://inews.gtimg.com/news_ls/Oupg0xRcDlSZgvgfcYOh7-MysGyoDn03lk1V0S32T1aikAA_150120/0'], 'ls_img_exp_type': '2', 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/O6fXtST7Qf6O5-_Lzko3DN_xVawOZJJBjNZPuL81UrbAQAA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/O6fXtST7Qf6O5-_Lzko3DN_xVawOZJJBjNZPuL81UrbAQAA_196130/0', '330x330': 'https://inews.gtimg.com/om_ls/O6fXtST7Qf6O5-_Lzko3DN_xVawOZJJBjNZPuL81UrbAQAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/OCOiIJ9IGfWN5pISafycyqO4-z8XbqR5J7mTko8zLP1RwAA_240240/0', 'aspect': '1.78', 'pic_first': 'https://puui.qpic.cn/vpic_cover/s1276mgw44h/s1276mgw44h_first.jpg/720'}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260708V05PMN00', 'url': 'https://new.qq.com/rain/a/20260708V05PMN00', 'short_url': 'https://view.inews.qq.com/a/20260708V05PMN00', 'org_url': 'https: