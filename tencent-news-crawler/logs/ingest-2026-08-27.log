ical_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '财经', 'cate1_en_name': 'finance', 'cate1_id': '20003038', 'cate2_name': '金融', 'cate2_id': '6905260'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '上海', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '黄金牛市即将重启？道富银行：初冬重回“5000大关”，1万美元不是梦', 'share_subtitle': '财联社8月27日讯（编辑 黄君芝）黄金前段时间的回调似乎并未对其长期投资前景造成太大损害，随着对不可持续主权债务的担忧再次成为全球金融市场的焦点，一位策略师认为，年末金价有望涨至每盎司5000美元。不过与此同时，道富投资管理公司黄金策略主管Aakash Doshi在接受最新采访时表示，投资者应该着眼于金价的下一个里程碑...'}, 'long_summary': '黄金前段时间的回调似乎并未对其长期投资前景造成太大损害，随着对不可持续主权债务的担忧再次成为全球金融市场的焦点，一位策略师认为，年末金价有望涨至每盎司5000美元。不过与此同时，道富投资管理公司黄金策略主管Aakash Doshi在接受最新采访时表示，投资者应该着眼于金价的下一个里程碑式的更高目标。在当前的全球经济环境下，他认为金价达到1万美元最终只是时机问题，而非可能性问题。Doshi表示，道富银行目前的基本预期是，到今年初冬，金价将达到每盎司4750美元至5500美元。'}, {'id': '20260827A0A9SK00', 'articletype': '0', 'title': '特朗普要给半导体“加税”！美国AI产业却可能先吃不消', 'pic_style': 0, 'publish_time': '2026-08-27 17:36:24', 'pic_info': {'big_img': ['https://inews.gtimg.com/news_ls/OV526TkfbGaw5w38NM2k53-mTWZbcif-FUSde19G3bv9UAA_870492/0'], 'small_img': ['https://inews.gtimg.com/news_ls/OV526TkfbGaw5w38NM2k53-mTWZbcif-FUSde19G3bv9UAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/OV526TkfbGaw5w38NM2k53-mTWZbcif-FUSde19G3bv9UAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/news_ls/OV526TkfbGaw5w38NM2k53-mTWZbcif-FUSde19G3bv9UAA_196130/0', '360x240': 'https://inews.gtimg.com/news_ls/OV526TkfbGaw5w38NM2k53-mTWZbcif-FUSde19G3bv9UAA_360240/0', '330x330': 'https://inews.gtimg.com/news_ls/OV526TkfbGaw5w38NM2k53-mTWZbcif-FUSde19G3bv9UAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/OkuK3Jugcj3xxlU6BG8q_8cng1ydAyOGbm-Qor3xWvRkgAA_240240/0', 'img_count': 2}, 'link_in