orite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '体育', 'cate1_en_name': 'sports', 'cate1_id': '20014398', 'cate2_name': '西甲', 'cate2_id': '7258608'}, 'declare': {}, 'pub_info': {'source': '6', 'sub_source': '121'}, 'payment_info': {}, 'user_address': '陕西', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '就是不卖给你！马竞官宣：绝不会与巴萨谈小蜘蛛交易 愿对话其他队', 'share_subtitle': '距离夏窗关闭还有6天时间，马竞今日再次官方发声，宣布绝对不会将“小蜘蛛”阿尔瓦雷斯卖给巴萨。此前，阿尔瓦雷斯曾公开要求转会，而巴萨也一直想签下他。      今夏，阿尔瓦雷斯和巴萨的传闻一直没有断过....'}, 'long_summary': '距离夏窗关闭还有6天时间，马竞今日再次官方发声，宣布绝对不会将“小蜘蛛”阿尔瓦雷斯卖给巴萨。此前，阿尔瓦雷斯曾公开要求转会，而巴萨也一直想签下他。今夏，阿尔瓦雷斯和巴萨的传闻一直没有断过。双方都对彼此有意，但马竞始终拒绝放人，且态度极度强硬。昨日，巴萨主席拉波尔塔强调他们对阿尔瓦雷斯的报价依然有效，愿意为这位阿根廷射手砸钱。8月27日，马竞官方宣布巴萨已经进入俱乐部的黑名单。俱乐部董事会一致认可，完全支持俱乐部不与巴萨就阿尔瓦雷斯的转会进行任何谈判。马竞宣称愿意与其他球队进行正常的转会谈判。'}, {'id': '20260827A0BS6E00', 'articletype': '0', 'title': '张本智和：我的目标是超越王楚钦成为世界第一！中国队是最后一道高墙', 'pic_style': 0, 'publish_time': '2026-08-27 19:38:35', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/Oq3KOP9vv1BIY36hcga6n74_YERgfbdgw16JLpr_gKC_wAA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/Oq3KOP9vv1BIY36hcga6n74_YERgfbdgw16JLpr_gKC_wAA_294195/0'], 'three_img': ['https://inews.gtimg.com/om_ls/Oq3KOP9vv1BIY36hcga6n74_YERgfbdgw16JLpr_gKC_wAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/om_ls/Oq3KOP9vv1BIY36hcga6n74_YERgfbdgw16JLpr_gKC_wAA_196130/0', '360x240': 'https://inews.gtimg.com/om_ls/Oq3KOP9vv1BIY36hcga6n74_YERgfbdgw16JLpr_gKC_wAA_360240/0', '330x330': 'https://inews.gtimg.com/om_ls/Oq3KOP9vv1BIY36hcga6n74_YERgfbdgw16JLpr_gKC_wAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/OC5QmbYiR4uUe6jAQ_KsG_-5S