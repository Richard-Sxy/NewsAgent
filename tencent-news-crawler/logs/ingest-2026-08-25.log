s/0/14465649134/0', 'daytime_url': 'http://inews.gtimg.com/newsapp_ls/0/14465648183/0'}}, 'interation_info': {'comment_id': '1260825605086761', 'commet_num': 15, 'read_num': 7012, 'like_num': 16, 'collect_num': 5, 'share_num': 17, 'share_wechat_num': 11}, 'doc_info': {'first_cate_id': '19', 'first_cate_name': 'auto', 'sec_cate_id': '1901', 'sec_cate_name': 'auto_chanye'}, 'update_time': '2026-08-25 20:30:00', 'news724_feature': None, 'desc': '出品｜虎嗅汽车组作者｜杨杰题图｜视觉中国2026年8月21日，国家市场监管总局发布一则公告。特斯拉、小米、小鹏、零跑、吉利、奇瑞、东风、北汽蓝谷、中国一汽九家车企，备案召回427.51万辆汽车。原因惊人地一致：车内应急机械拉手与内饰颜色接近，不易识别和操作。看似大规模的召回，但多数车企的整改方案，却简单到令人捧...', 'safe_control': {'close_all_ad': 0, 'close_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '汽车', 'cate1_en_name': 'car', 'cate1_id': '60037744', 'cate2_name': '车生活', 'cate2_id': '6188441'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '427万辆车召回警示：造车十余年，连个门把手都造不好？', 'share_subtitle': '出品｜虎嗅汽车组作者｜杨杰题图｜视觉中国2026年8月21日，国家市场监管总局发布一则公告。特斯拉、小米、小鹏、零跑、吉利、奇瑞、东风、北汽蓝谷、中国一汽九家车企，备案召回427.51万辆汽车。原因惊人地一致：车内应急机械拉手与内饰颜色接近，不易识别和操作。看似大规模的召回，但多数车企的整改方案，却简单到令人捧...'}, 'long_summary': '2026年8月21日，国家市场监管总局发布一则公告。特斯拉、小米、小鹏、零跑、吉利、奇瑞、东风、北汽蓝谷、中国一汽九家车企，备案召回427.51万辆汽车。看似大规模的召回，但多数车企的整改方案，却简单到令人捧腹：仅是一张贴纸便能完成，部分车型则配合一次OTA升级。更值得玩味的是：隐藏式门把手，这个曾被新势力当作科技感标志的设计，如今成了整个行业的集体尴尬。在全隐藏式门把手即将被强制禁止的背景之下，更值得追问的问题是：新能源造车狂奔十余载，既然收益微弱、风险明确，它为什么能成为全行业标配？'}, {'id': '20260825A0AUO700', 'articletype': '0', 'title': '道交法迎重大修订：自动驾驶时违法，车企全责', 'pic_style': 0, 'publish_time': '2026-08-25 19:20:20', 'pic_info': {'big_img': ['https://inews.gtimg.com/news_ls/O1eOUWdgZrvAd7poCRuy-MwEN5_LfcXUC51b22VDvxPucAA_870492/0'], 'small_img': ['https://inews.gtimg.com/news_ls/O1eOUWdgZrvAd7poCRuy-MwEN5_LfcXUC51b22VDvxPucAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/O1eOUWdgZrvAd7poCRuy-MwEN5_LfcXUC51b22VDvxPucAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/news_ls/O1eOUWdgZrvAd7poCRuy-MwEN5_LfcXUC51b22VDvxPucAA_196130/0', '360x240': 'https://inews.gtimg.com/news_ls/O1eOUWdgZrvAd7poCRuy-MwEN5_LfcXUC51b22VDvxPucAA_360240/0', '330x330': 'https://inews.gtimg.com/news_ls/O1eOUWdgZrvAd7poCRuy-MwEN5_LfcXUC51b22VDvxPucAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/OrskY1imLWlMF10HWmEjv4mZl2mihhbhpgHO3fAB0NDPAAA_240240/0', 'img_count': 2}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260825A0AUO700', 'url': 'https://view.inews.qq.com/a/20260825A0AUO700', 'short_url': 'https://view.inews.qq.com/a/20260825A0AUO700', 'org_url': 'https://view.inews.qq.com/a/20260825A0AUO700'}, 'media_info': {'chl_id': '5139399', 'chl_name': 'AutoReport每日汽车新闻', 'icon': 'http://inews.gtimg.com/newsapp_ls/0/15353488509_200200/0', 'sicon': 'http://inews.gtimg.com/newsapp_ls/0/15353488509_200200/0', 'mrk': '汽车产经网旗下官方视频平台\n最新鲜的车圈资讯~\n最有趣的大佬观点~\n最热辣的车事点评～\n感谢如此优秀的你关注+点赞', 'last_art_update': '0', 'encoded_suid': '8QEf3X5d7YEevj7e7wF3', 'vip_type': '30012', 'vip_type_new': '30012', 'vip_desc': '汽车产经网官方账号', 'vip_icon': 'http://inews.gtimg.com/newsapp_ls/0/14876051701/0', 'medal_info': {'type_id': 25, 'medal_id': 39, 'medal_level': 1, 'medal_name': '千锤百炼', 'medal_desc': '腾讯新闻粉丝数达到1000', 'night_url': 'http://inews.gtimg.com/newsapp_ls/0/14465639253/0', 'daytime_url': 'http://inews.gtimg.com/newsapp_ls/0/14465637934/0'}}, 'interation_info': {'comment_id': '1260825605168071', 'commet_num': 3, 'read_num': 417, 'like_num': 2, 'collect_num': 1, 'share_num': 11, 'share_wechat_num': 10}, 'doc_info': {'first_cate_id': '19', 'first_cate_name': 'auto', 'sec_cate_id': '1906', 'sec_cate_name': 'auto_tech'}, 'update_time': '2026-08-25 20:30:00', 'news724_feature': None, 'desc': '撰文｜于雷 编辑｜甘猛 出品｜汽车产经如果车辆开着自动驾驶闯红灯了，责任到底是谁的？这个问题以后就不存在争议了。8月25日，《道路交通安全法（修订草案）》（下文简称：草案）提请十四届全国人大常委会第二十四次会议初次审议。草案专门新增了“自动驾驶汽车的特别规定”一章。这是自动驾驶第一次以专章形式进入提请全...', 'safe_control': {'close_all_ad': 0, 'close_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '汽车', 'cate1_en_name': 'car', 'cate1_id': '60037744', 'cate2_name': '行业资讯', 'cate2_id': '21595110'}, 'declare': {}, 'pub_info': {'source': '1', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '道交法迎重大修订：自动驾驶时违法，车企全责', 'share_subtitle': '撰文｜于雷 编辑｜甘猛 出品｜汽车产经如果车辆开着自动驾驶闯红灯了，责任到底是谁的？这个问题以后就不存在争议了。8月25日，《道路交通安全法（修订草案）》（下文简称：草案）提请十四届全国人大常委会第二十四次会议初次审议。草案专门新增了“自动驾驶汽车的特别规定”一章。这是自动驾驶第一次以专章形式进入提请全...'}, 'long_summary': '如果车辆开着自动驾驶闯红灯了，责任到底是谁的？8月25日，《道路交通安全法》提请十四届全国人大常委会第二十四次会议初次审议。草案专门新增了“自动驾驶汽车的特别规定”一章。这是自动驾驶第一次以专章形式进入提请全国人大常委会审议的《道路交通安全法》修订草案。草案明确了自动驾驶汽车和辅助驾驶功能的概念，并且规定在自动驾驶功能激活状态下，如果发生道路交通安全违法行为，由汽车生产企业、进口企业接受处理。不过需要注意，草案明确的是自动驾驶状态下的“交通违法行为”，而不是“事故责任”。'}, {'id': '20260825A0BJFB00', 'articletype': '0', 'title': '小鹏需要卖出更多技术分担造车成本', 'pic_style': 0, 'publish_time': '2026-08-25 19:34:04', 'pic_info': {'big_img': ['https://inews.gtimg.com/news_ls/Os_iE4yqMIk_ady_Hxlgec6qiy9RGokbjEJ9-hoyBOv7IAA_870492/0'], 'small_img': ['https://inews.gtimg.com/news_ls/Os_iE4yqMIk_ady_Hxlgec6qiy9RGokbjEJ9-hoyBOv7IAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/Os_iE4yqMIk_ady_Hxlgec6qiy9RGokbjEJ9-hoyBOv7IAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/news_ls/Os_iE4yqMIk_a