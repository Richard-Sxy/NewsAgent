tion': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '科技', 'cate1_en_name': 'tech', 'cate1_id': '20786087', 'cate2_name': '电商', 'cate2_id': '5275037'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '地址决定货色：电商AB货的分级生意', 'share_subtitle': '电商行业的价格内卷，正在向品控环节传导。同一款商品，同一套链接，收货地址在录入的那一刻，就已经决定了到手的货品是做工精良的“A货”，还是压缩成本的“B货”。这套被从业者称为“AB货”的分级发货，正从个别商家的灰色操作，蔓延为行业性的普遍做法。一双品牌鞋，线下店的脚感舒服、质感扎实，电商旗舰店的却颜色发灰...'}, 'long_summary': '电商行业的价格内卷，正在向品控环节传导。同一款商品，同一套链接，收货地址在录入的那一刻，就已经决定了到手的货品是做工精良的“A货”，还是压缩成本的“B货”。这套被从业者称为“AB货”的分级发货，正从个别商家的灰色操作，蔓延为行业性的普遍做法。一双品牌鞋，线下店的脚感舒服、质感扎实，电商旗舰店的却颜色发灰，脚感也远不如线下那双。同一个商品链接，邮到省城的发夹明显比发往乡镇老家的那只更大。这就是电商行业里流传已久的“AB货”。它不算新词，却在消费者的私下讨论里存在了多年，如今被摆上了台面。'}, {'id': '20260825A0AHIF00', 'articletype': '0', 'title': '中国半导体，越来越绕不开西安？', 'pic_style': 0, 'publish_time': '2026-08-25 18:03:09', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OJRMm-5n08xXL6PYaswW5T8ZAaF0tGX2UdywJ87pkYAVQAA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/OJRMm-5n08xXL6PYaswW5T8ZAaF0tGX2UdywJ87pkYAVQAA_294195/0'], 'three_img': ['https://inews.gtimg.com/om_ls/OJRMm-5n08xXL6PYaswW5T8ZAaF0tGX2UdywJ87pkYAVQAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/om_ls/OJRMm-5n08xXL6PYaswW5T8ZAaF0tGX2UdywJ87pkYAVQAA_196130/0', '360x240': 'https://inews.gtimg.com/om_ls/OJRMm-5n08xXL6PYaswW5T8ZAaF0tGX2UdywJ87pkYAVQAA_360240/0', '330x330': 'https://inews.gtimg.com/om_ls/OJRMm-5n08xXL6PYaswW5T8ZAaF0tGX2UdywJ87pkYAVQAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/OnmAlW80xULdQT8k0L0oZpMmDUrck7WCQNQQPg80PZPYQAA_240240/0', 'img_count': 3}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/2026