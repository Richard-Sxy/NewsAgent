me': '汽车', 'cate1_en_name': 'car', 'cate1_id': '60037744', 'cate2_name': '行业资讯', 'cate2_id': '21595110'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '上海', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '小鹏需要卖出更多技术分担造车成本', 'share_subtitle': '界面新闻记者 | 王臻界面新闻编辑 | 周姝祺以卖车为主要收入来源的小鹏汽车，正在越来越依赖汽车之外的业务创造利润。根据小鹏汽车披露的中期业绩报告，2026年第二季度，汽车销售占小鹏总收入的86.3%，只贡献了50.4%的毛利润；服务及其他业务收入占比仅为13.7%，毛利润贡献却达到49.6%。去年同期，汽车销售还贡献了公司超过...'}, 'long_summary': '以卖车为主要收入来源的小鹏汽车，正在越来越依赖汽车之外的业务创造利润。根据小鹏汽车披露的中期业绩报告，2026年第二季度，汽车销售占小鹏总收入的86.3%，只贡献了50.4%的毛利润；服务及其他业务收入占比仅为13.7%，毛利润贡献却达到49.6%。考虑到市场竞争形势和原材料成本上涨，短期内小鹏汽车依然需要技术输出提供利润支持。如果小鹏汽车能够把同一套平台、架构、芯片或智能驾驶技术出售给第二家、第三家汽车制造商，并控制新增定制开发成本，外部客户将共同分担底层研发投入。'}, {'id': '20260825V097LD00', 'articletype': '4', 'title': '手机跨界车企第一人徐军：“灰度”中寻找边界｜石丁Talk', 'pic_style': 4, 'publish_time': '2026-08-25 16:38:19', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OmKQfFEbg_ZDSI13vbh4ruzi4njl-xBS0lLrbOcm1JnYAAA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/OmKQfFEbg_ZDSI13vbh4ruzi4njl-xBS0lLrbOcm1JnYAAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/O3hSPUNGx5ErfMBkK-rJBKFawpM-vzYQimM1I_Ws29rjwAA_150120/0'], 'ls_img_exp_type': '2', 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/OmKQfFEbg_ZDSI13vbh4ruzi4njl-xBS0lLrbOcm1JnYAAA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/OmKQfFEbg_ZDSI13vbh4ruzi4njl-xBS0lLrbOcm1JnYAAA_196130/0', '330x330': 'https://inews.gtimg.com/om_ls/OmKQfFEbg_ZDSI13vbh4ruzi4njl-xBS0lLrbOcm1JnYAAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/O6MtHwiDd0Si6LGyOns7lb35mJjjqp5SsP657deS6VbWIAA_240240/0', 'aspect': '1.78', 'pic_first': 'https://puui.qpic.cn/vpic_cover/l1284bu5u63/l1284bu5u63_first.jpg/720'}, 'link_inf