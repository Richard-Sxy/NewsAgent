s_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '热刺官宣第7签！萨维尼奥签5年，转会费1亿欧，夏窗已投3.6亿', 'share_subtitle': '周二，托特纳姆热刺通过俱乐部网站宣布签入萨维尼奥，双方签约5年，萨维尼奥的转会费总价达到8500万英镑。      在2025-26赛季，热刺仅以41分排名第17位。在夏窗，热刺希望通过引援来提升球....'}, 'long_summary': '周二，托特纳姆热刺通过俱乐部网站宣布签入萨维尼奥，双方签约5年，萨维尼奥的转会费总价达到8500万英镑。在2025-26赛季，热刺仅以41分排名第17位。在夏窗，热刺希望通过引援来提升球队的实力，此前已经签入了托纳利、马特乌斯-费尔南德斯、范赫克、塞内西、罗伯逊、杜布拉夫卡6名球员。22岁的萨维尼奥2024年7月以5000万欧元的转会费加盟曼城，在之后两个赛季，萨维尼奥为曼城出场84次，打入7球送出16次助攻。在签入萨维尼奥之后，热刺在夏窗的投入已经高达3.66亿欧元，在英超球队里仅次于切尔西。'}, {'id': '20260825V09K6X00', 'articletype': '4', 'title': '一票难求！暑期档最火“大片”，竟是去电影院看樊振东？', 'pic_style': 4, 'publish_time': '2026-08-25 17:02:35', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OKll3ONoa_FaP265g_Mj4S9hx59fT6e6eB7j36cZugXQgAA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/OKll3ONoa_FaP265g_Mj4S9hx59fT6e6eB7j36cZugXQgAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/OXtrPVaO9knqpqVoombduig9x3kJdRR9t3H9capmjeEJ8AA_150120/0'], 'ls_img_exp_type': '2', 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/OKll3ONoa_FaP265g_Mj4S9hx59fT6e6eB7j36cZugXQgAA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/OKll3ONoa_FaP265g_Mj4S9hx59fT6e6eB7j36cZugXQgAA_196130/0', '330x330': 'https://inews.gtimg.com/om_ls/OKll3ONoa_FaP265g_Mj4S9hx59fT6e6eB7j36cZugXQgAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/O9Re7ITjPpKrUKUT39bTPx_BB30dvwgj1rcOkoa9cNh80AA_240240/0', 'aspect': '1.33', 'pic_first': 'https://puui.qpic.cn/vpic_cover/z1284amlm42/z1284amlm42_first.jpg/720'}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260825V09K6X00', 'url': 'https://view.inews.qq.com/a/20260825V09K6X00', 'short_url': 'https://view.inews.qq.com/a/20260825V09K6X00', 'org_url': 'https://view.inews.qq.com/a/20260825V09K6X00'}, 'media_info': {'chl_id': '21201548', 'chl_name': '腾讯新闻体育', 'icon': 'http://inews.gtimg.com/newsapp_ls/0/14368916186_200200/0', 'sicon': 'http://inews.gtimg.com/newsapp_ls/0/14368916186_200200/0', 'mrk': '腾讯新闻体育官方账号', 'l