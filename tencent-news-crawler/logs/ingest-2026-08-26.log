oticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '汽车', 'cate1_en_name': 'car', 'cate1_id': '60037744', 'cate2_name': '行业资讯', 'cate2_id': '21595110'}, 'declare': {}, 'pub_info': {'source': '6', 'sub_source': '121'}, 'payment_info': {}, 'user_address': '广东', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '汽车行业中的“亏损大户”：年销量数百万台，亏损金额却达1696亿', 'share_subtitle': '2026年《财富》世界500强榜单如期而至，一如往年般掀起全球商业界的关注浪潮。在行业板块的激烈竞逐中，车辆与零部件领域共有35家企业入围，再次印证了汽车工业作为国民经济支柱与制造业集大成者的稳固地....'}, 'long_summary': '2026年《财富》世界500强榜单如期而至，一如往年般掀起全球商业界的关注浪潮。在行业板块的激烈竞逐中，车辆与零部件领域共有35家企业入围，再次印证了汽车工业作为国民经济支柱与制造业集大成者的稳固地位。这些巨头凭借庞大的产能规模、遍布全球的供应链网络以及数以百万计的年销量，动辄斩获上千亿美元的年营业收入，是当之无愧的全球制造业“压舱石”。从世界500榜单公布的数据来看，亏损的汽车巨头有Stellantis集团、雷诺、福特汽车公司、日产汽车以及本田汽车等。'}], 'ad_list': '', 'trace_id': '', 'fixed_nums': 0, 'is_deleted': 0, 'code': 0, 'message': '', 'timestamp': '', 'hot_list': None, 'plugin_audio': None, 'native_ad_data': None}
