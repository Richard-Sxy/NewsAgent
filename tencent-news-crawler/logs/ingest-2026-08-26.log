se_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '体育', 'cate1_en_name': 'sports', 'cate1_id': '20014398', 'cate2_name': '英超', 'cate2_id': '8388059'}, 'declare': {}, 'pub_info': {'source': '6', 'sub_source': '121'}, 'payment_info': {}, 'user_address': '河南', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}, {'type': 'dislike_block', 'name': '不推荐: 穆里尼奥', 'id': '4453460'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '英媒评英超十大主帅：瓜迪奥拉第2，穆里尼奥第4，榜首无悬念！', 'share_subtitle': '英超联赛自1992年成立以来，已经走过了三十多个年头。三十年间，有无数名帅在这片舞台上书写过自己的传奇。有人登顶封神，有人黯然离场，有人带走了冠军奖杯，有人留下了永恒的经典。不久前，英国媒体《BBC....'}, 'long_summary': '英超联赛自1992年成立以来，已经走过了三十多个年头。有人登顶封神，有人黯然离场，有人带走了冠军奖杯，有人留下了永恒的经典。不久前，英国媒体《BBC》评选出了英超时代最伟大的十名主教练。很多大家耳熟能详的名字，悉数出现在了榜单中。安切洛蒂排第十，多少有点“委屈”了。上个赛季，他成为了第13位赢得英超冠军的主教练，也是自2004年温格之后首位率领阿森纳夺冠的主帅。更重要的是，他终结了曼城或利物浦长达八年对英超冠军的垄断。排名榜首的教练没有任何悬念，英超前二十年，几乎就是弗格森一个人的独角戏。'}, {'id': '20260825V085UE00', 'articletype': '4', 'title': '丁俊晖斯诺克名场面，上手直接打脸塞大师，磨王扛不住当场发脾气｜体坛记忆', 'pic_style': 4, 'publish_time': '2026-08-26 02:40:00', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/Oyx-i68anwJ-cauGnhebDIlzPAl0Y2V05NjEBEN_a2PSgAA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/Oyx-i68anwJ-cauGnhebDIlzPAl0Y2V05NjEBEN_a2PSgAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/OQT-kTa5AcAYkLOA4F6OijW_6Rmsd-Orq-lCtkpFL0lQMAA_150120/0'], 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/Oyx-i68anwJ-cauGnhebDIlzPAl0Y2V05NjEBEN_a2PSgAA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/Oyx-i68anwJ-cauGnhebDIlzPAl0Y2V05NjEBEN_a2PSgAA_196130/0', '330x330': 'https://inews.gtimg.com/om_ls/Oyx-i68anwJ-cauGnhebDIlzPAl0Y2V05NjEBEN_a2PSgAA_330330/0'}, 'share_img': 'htt