se_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '财经', 'cate1_en_name': 'finance', 'cate1_id': '20003038', 'cate2_name': '商业公司', 'cate2_id': '21102997'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '四川', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '恒大相关债权拍卖：有1.03亿元债权组合包，以14万元成交', 'share_subtitle': '红星资本局8月26日消息 8月26日，多笔包括恒大相关公司债权、金额上亿元的债权组合包的拍卖结果出炉，成交价在6.57万元到14.41万元不等。据红星资本局此前报道，近期，有一批恒大相关公司的债权挂上阿里资产平台，债权金额超过2.7亿元，但相关债权组合包的起拍价从9.9元至301元不等，开始拍卖的时间不同。▲创意配图 据图虫...'}, 'long_summary': '8月26日，多笔包括恒大相关公司债权、金额上亿元的债权组合包的拍卖结果出炉，成交价在6.57万元到14.41万元不等。据红星资本局此前报道，近期，有一批恒大相关公司的债权挂上阿里资产平台，债权金额超过2.7亿元，但相关债权组合包的起拍价从9.9元至301元不等，开始拍卖的时间不同。据红星资本局不完全统计，8月26日，有三笔债权拍卖结束，成交价在6.57万元到14.41万元不等。相比债权金额1.03亿元，成交价不足其1%。'}, {'id': '20260825A0D0ZP00', 'articletype': '0', 'title': '胖东来许昌新店已正式注册成立，与即将关闭的生活广场店相隔仅4公里，或将承接全部老店员工', 'pic_style': 0, 'publish_time': '2026-08-26 08:11:19', 'pic_info': {'big_img': ['https://inews.gtimg.com/news_ls/O4y7vrrZE_zDazoDNbU501V9A7kDRIiJdQTNe22tjaOC0AA_870492/0'], 'small_img': ['https://inews.gtimg.com/news_ls/O4y7vrrZE_zDazoDNbU501V9A7kDRIiJdQTNe22tjaOC0AA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/O4y7vrrZE_zDazoDNbU501V9A7kDRIiJdQTNe22tjaOC0AA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/news_ls/O4y7vrrZE_zDazoDNbU501V9A7kDRIiJdQTNe22tjaOC0AA_196130/0', '360x240': 'https://inews.gtimg.com/news_ls/O4y7vrrZE_zDazoDNbU501V9A7kDRIiJdQTNe22tjaOC0AA_360240/0', '330x330': 'https://inews.gtimg.com/news_ls/O4y7vrrZE_zDazoDNbU501V9A7kDRIiJdQTNe22tjaOC0AA_330330/0'}, 'share_img'