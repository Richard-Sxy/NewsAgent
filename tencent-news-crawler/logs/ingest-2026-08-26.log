, 'pc_not_display': ''}, 'category': {'cate1_name': '科技', 'cate1_en_name': 'tech', 'cate1_id': '20786087', 'cate2_name': '科技职场', 'cate2_id': '70093124'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '苹果总部数十名软件工程师被裁', 'share_subtitle': '8月26日消息，据旧金山纪事报报道，在备受瞩目的产品发布前几周，苹果公司裁掉了位于硅谷的 147 名员工，他们大多是软件工程师。该公司周二公布的一份WARN文件中宣布，将在其位于库比蒂诺One Apple Park Way的总部裁员79人，在桑尼维尔西莫德大道605号的办公室裁员40人，在桑尼维尔北玛蒂尔达大道599号的办公室裁员28人。虽...'}, 'long_summary': '在备受瞩目的产品发布前几周，苹果公司裁掉了位于硅谷的147名员工，他们大多是软件工程师。该公司周二公布的一份WARN文件中宣布，将在其位于库比蒂诺One Apple Park Way的总部裁员79人，在桑尼维尔西莫德大道605号的办公室裁员40人，在桑尼维尔北玛蒂尔达大道599号的办公室裁员28人。虽然位于库比蒂诺环形“飞船”办公楼的软件开发工程师受到的裁员最多，但桑尼维尔办公室负责增强现实和虚拟现实产品的软件工程师受到的影响最大。此次裁员正值这家全球最有价值的公司之一即将迎来重要月份之际。'}, {'id': '20260825A0CFSB00', 'articletype': '0', 'title': '0mm边框…这国产新机有点好看啊', 'pic_style': 0, 'publish_time': '2026-08-25 21:12:20', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OufmSre8oWmXiWRxwS65_ysWAUn3w5EILlDr3zJsSgzr8AA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/OufmSre8oWmXiWRxwS65_ysWAUn3w5EILlDr3zJsSgzr8AA_294195/0'], 'three_img': ['https://inews.gtimg.com/om_ls/OufmSre8oWmXiWRxwS65_ysWAUn3w5EILlDr3zJsSgzr8AA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/om_ls/OufmSre8oWmXiWRxwS65_ysWAUn3w5EILlDr3zJsSgzr8AA_196130/0', '360x240': 'https://inews.gtimg.com/om_ls/OufmSre8oWmXiWRxwS65_ysWAUn3w5EILlDr3zJsSgzr8AA_360240/0', '330x330': 'https://inews.gtimg.com/om_ls/OufmSre8oWmXiWRxwS65_ysWAUn3w5EILlDr3zJsSgzr8AA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/Olwdh2xX7GIyB2K5gWYedcspX70Dg9-nSr4MO43_HM26YAA_240240/0', 'img_count': 25}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260825A0CFSB00', 'url': 'https://new.qq.com/rain/a/20260825A0CFSB00', 'short_url': 'https://view.inews.qq.com/a/20260825A0CFSB00', 'org_url': 'https://view.inews.qq.com/a/20260825A0CFSB00'}, 'media_info': {'chl_id': '5041389', 'chl_name': '锋潮评测', 'icon': 'http://inews.gtimg.com/newsapp_ls/0/267887782_200200/0', 'sicon': 'http://inews.gtimg.com/newsapp_ls/0/267887782_200200/0', 'mrk': '发现科技，改变生活。', 'last_art_update': '0', 'uin': 'ecd5d7112a7f388ec72528b8a504a1ffad', 'encoded_suid': '8QMf23hc6YYdsTne', 'vip_type': '30011', 'vip_type_new': '30011', 'vip_desc': '科技领域创作者', 'vip_icon': 'http://inews.gtimg.com/newsapp_ls/0/14876048581/0', 'medal_info': {'type_id': 26, 'medal_id': 40, 'medal_level': 1, 'medal_name': '万众瞩目', 'medal_desc': '腾讯新闻粉丝数达到1w', 'night_url': 'http://inews.gtimg.com/newsapp_ls/0/14465644517/0', 'daytime_url': 'http://inews.gtimg.com/newsapp_ls/0/14465643388/0'}}, 'interation_info': {'comment_id': '1260825605242091', 'commet_num': 2, 'read_num': 664, 'like_num': 1, 'collect_num': 1}, 'doc_info': {'first_cate_id': '7', 'first_cate_name': 'digital', 'sec_cate_id': '703', 'sec_cate_name': 'digital_phone'}, 'update_time': '2026-08-26 20:30:02', 'news724_feature': None, 'desc': '整活这块，还得看传音。      之前机哥跟机友们聊过，在 iPhone 20 周年“无边框”手机问世之前，传音秀出了“全球首款 0mm 边框”的手机——      Next-Gen Bezelle....', 'safe_control': {'close_all_ad': 0, 'close_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '数码', 'cate1_en_name': 'digital', 'cate1_id': '60044140', 'cate2_name': '手机', 'cate2_id': '2913074'}, 'declare': {}, 'pub_info': {'source': '1', 'sub_source': '117'}, 'payment_info': {}, 'user_address': '广东', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '0mm边框…这国产新机有点好看啊', 'share_subtitle': '整活这块，还得看传音。      之前机哥跟机友们聊过，在 iPhone 20 周年“无边框”手机问世之前，传音秀出了“全球首款 0mm 边框”的手机——      Next-Gen Bezelle....'}, 'long_summary': '整活这块，还得看传音。Next-Gen Bezelless Concept Phone。而最近有博主上手了这台机子。不得不说，传音这次真没吹牛。手机正面就只能看到金属中框，而黑边几乎完全消失。乍一眼看过去，甚至像一台白色前面板的手机。那么问题来了，传音到底是怎么实现的呢。如果仔细看的话还是能看出来，这台机子，是有一条极窄黑边的。但传音搞了点小动作，把金属中框做到突出屏幕一截，并且向内弯折。所以从正面看，黑边被中框挡住。理是这么个理，但传音这台机子是「概念机」，短期内不会量产端出来卖。'}, {'id': '20260826V08QWY00', 'articletype': '4', 'title': '5岁女童被机器人踢掉4颗牙，运营方回应：是宇树机器人，今年已发生多起误伤事故，业内称门槛低 买得起就能干', 'pic_style': 4, 'publish_time': '2026-08-26 15:51:03', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OdsUNyrqpkmXEGq4DnAccWHaQTAL4PIV2g2myxxijBw64AA_870492_compress/0'], 'small_img': ['https://inews.gtimg.com/om_ls/OWJ3jTVEO1pFouoQUNyHKNKOwkFs5WgYcRS3AOaArev-8AA_294195_compress/0'], 'three_img': ['https://inews.gtimg.com/om_ls/ODdpZDroor0P1eVjJZTLQ5kVS2rjiS2npukYmc__tD1z4AA_150120/0'], 'ls_img_exp_type': '1', 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/OlzNuHM6Z-rP7zOiHLUicFckf7t_FTKC53e2404vpvOYkAA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/OlzNuHM6Z-rP7zOiHLUicFckf7t_FTKC53e2404vpvOYkAA_196130/0', '330x330': 'https://inews.gtimg.com/om_ls/OlzNuHM6Z-rP7zOiHLUicFckf7t_FTKC53e2404vpvOYkAA_330330/0', '480x640': 'https://inews.gtimg.com/om_ls/OlzNuHM6Z-rP7zOiHLUicFckf7t_FTKC53e2404vpvOYkAA_480640/0'}, 'share_img': 'https://inews.gtimg.com/om_ls/OWJ3jTVEO1pFouoQUNyHKNKOwkFs5WgYcRS3AOaArev-8AA_294195_compress/0', 'aspect': '0.56', 'pic_first': 'https://puui.qpic.cn/vpic_cover/a1284q6c0kv/a1284q6c0kv_first.jpg/720'}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260826V08QWY00', 'url': 'https://new.qq.com/rain/a/20260826V08QWY00', 'short_url': 'https://view.inews.qq.com/a/20260826V08QWY00', 'org_url': 'https://view.inews.qq.com/a/20260826V08QWY00'}, 'media_info': {'chl_id': '5376464', 'chl_name': '中新经纬', 'icon': 'http://inews.gtimg.com/newsapp_ls/0/82892971