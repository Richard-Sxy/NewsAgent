_ls/OR8j3Xvi1_CPq6C_Ok2rD1Ik6qvdQnthkNNchUlbXD9BMAA_360240/0', '330x330': 'https://inews.gtimg.com/news_ls/OR8j3Xvi1_CPq6C_Ok2rD1Ik6qvdQnthkNNchUlbXD9BMAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/ONXtoJ0T2TduV8UpY-bhjgZXTT8LqKTOlPS0sYwhcM18gAA_240240/0', 'img_count': 8}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260822A097O300', 'url': 'https://view.inews.qq.com/a/20260822A097O300', 'short_url': 'https://view.inews.qq.com/a/20260822A097O300', 'org_url': 'https://view.inews.qq.com/a/20260822A097O300'}, 'media_info': {'chl_id': '1101', 'chl_name': '极客公园', 'icon': 'http://inews.gtimg.com/newsapp_ls/0/9899953873_200200/0', 'sicon': 'http://inews.gtimg.com/newsapp_ls/0/9899953873_200200/0', 'mrk': '用极客视角，追踪你最不可错过的科技圈。有快闻、也有洞见；有脑洞、也有思考。', 'last_art_update': '0', 'uin': 'ec9bca18dfe3f7e8f5e42ef3c2510517ba', 'encoded_suid': '8QMX2ndU7oYcuTc=', 'vip_type': '30013', 'vip_type_new': '30013', 'vip_desc': '极客公园官方账号', 'vip_icon': 'http://inews.gtimg.com/newsapp_ls/0/14876049251/0', 'medal_info': {'type_id': 31, 'medal_id': 45, 'medal_level': 1, 'medal_name': '别具慧眼', 'medal_desc': '成为荐评手，一起建设腾讯新闻社区！', 'night_url': 'https://new.inews.gtimg.com/tnews/8c3d00f9/7f36/8c3d00f9-7f36-44a9-82c4-be357b54fe9b.png', 'daytime_url': 'https://new.inews.gtimg.com/tnews/45af77fe/a73d/45af77fe-a73d-42d2-ab80-feaa383611de.png'}}, 'interation_info': {'comment_id': '1260822605091603', 'commet_num': 8, 'read_num': 971, 'like_num': 9, 'collect_num': 29, 'share_num': 46, 'share_wechat_num': 43}, 'doc_info': {'first_cate_id': '29', 'first_cate_name': 'edu', 'sec_cate_id': '2920', 'sec_cate_name': 'edu_junior'}, 'update_time': '2026-08-22 20:30:00', 'news724_feature': None, 'desc': '「坏 AI，使人笨！」作者｜张勇毅编辑｜靖宇「AI 用多了，人会不会逐渐变笨？」这应该是过去三年被讨论最多的一个迷思之一，从 ChatGPT 走红那天就有。吵了三年多，两边都拿不出像样的证据：担心的人只有体感，不担心的人只有立场。8 月 18 日，《经济学人》给这场争论补上了迄今最硬的一份证据。报道的主角是 2.7 万名中国...', 'safe_control': {'close_all_ad': 0, 'close_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '科技', 'cate1_en_name': 'tech', 'cate1_id': '20786087', 'cate2_name': '人工智能', 'cate2_id': '8441946'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '甘肃', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '越会用AI的人，学习能力退化得越快', 'share_subtitle': '「坏 AI，使人笨！」作者｜张勇毅编辑｜靖宇「AI 用多了，人会不会逐渐变笨？」这应该是过去三年被讨论最多的一个迷思之一，从 ChatGPT 走红那天就有。吵了三年多，两边都拿不出像样的证据：担心的人只有体感，不担心的人只有立场。8 月 18 日，《经济学人》给这场争论补上了迄今最硬的一份证据。报道的主角是 2.7 万名中国...'}, 'long_summary': '“AI用多了，人会不会逐渐变笨？”这应该是过去三年被讨论最多的一个迷思之一，从ChatGPT走红那天就有。8月18日，《经济学人》给这场争论补上了迄今最硬的一份证据。报道的主角是2.7万名中国中学生。用上AI之后，他们的作业分数平均涨了18%，写一份作业的时间从64分钟缩到45分钟。到这里全是好消息，直到月考卷子发下来：闭卷考试里，这批学生的成绩比不用AI的同学低了20%。作业分曾是最可靠的「晴雨表」：作业越好，考试越好。而在用AI的学生中间，作业分越高，基本等于AI用得越深。'}], 'news724_feature': None, 'safe_control': None, 'category': None}, {'id': '20260821A0AXS100', 'articletype': '0', 'title': '铜缆高速连接器：AI算力时代的“大动脉”', 'pic_style': 0, 'publish_time': '2026-08-21 17:33:11', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/O2x-Nznm4akERHW1wea3PxzCzLemZi5FIHjAdaINyt9fUAA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/O2x-Nznm4akERHW1wea3PxzCzLemZi5FIHjAdaINyt9fUAA_294195/0'], 'three_img': ['https://inews.gtimg.com/om_ls/O2x-Nznm4akERHW1wea3PxzCzLemZi5FIHjAdaINyt9fUAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/om_ls/O2x-Nznm4akERHW1wea3PxzCzLemZi5FIHjAdaINyt9fUAA_196130/0', '360x240': 'https://inews.gtimg.com/om_ls/O2x-Nznm4akERHW1wea3PxzCzLemZi5FIHjAdaINyt9fUAA_360240/0', '330x330': 'https://inews.gtimg.com/om_ls/O2x-Nznm4akERHW1wea3PxzCzLemZi5FIHjAdaINyt9fUAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/O6Pss8K