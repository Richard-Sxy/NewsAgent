o': {'first_cate_id': '12', 'first_cate_name': 'finance', 'sec_cate_id': '1204', 'sec_cate_name': 'finance_yinhang'}, 'update_time': '2026-08-22 20:30:05', 'news724_feature': None, 'desc': '每经记者：李玉雯 每经编辑：魏官红个人消费贷财政贴息政策再度优化。8月21日，财政部、中国人民银行和金融监管总局联合发布《关于进一步做好财政金融协同促内需政策有关工作的通知》（以下简称《通知》），将个人在单家经办机构的个人消费贷和信用卡分期业务贴息上限由每年3000元提高至每年5000元。同时，在今年1月将信用...', 'safe_control': {'close_all_ad': 0, 'close_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '财经', 'cate1_en_name': 'finance', 'cate1_id': '20003038', 'cate2_name': '银行', 'cate2_id': '3277224'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '云南', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '额度提高、范围扩大！个人消费贷款贴息“红包”升级，多家银行答疑', 'share_subtitle': '每经记者：李玉雯 每经编辑：魏官红个人消费贷财政贴息政策再度优化。8月21日，财政部、中国人民银行和金融监管总局联合发布《关于进一步做好财政金融协同促内需政策有关工作的通知》（以下简称《通知》），将个人在单家经办机构的个人消费贷和信用卡分期业务贴息上限由每年3000元提高至每年5000元。同时，在今年1月将信用...'}, 'long_summary': '个人消费贷财政贴息政策再度优化。8月21日，财政部、中国人民银行和金融监管总局联合发布《关于进一步做好财政金融协同促内需政策有关工作的通知》，将个人在单家经办机构的个人消费贷和信用卡分期业务贴息上限由每年3000元提高至每年5000元。同时，在今年1月将信用卡账单分期业务纳入贴息范围后，此次贴息范围扩大至信用卡专项分期、消费分期、预借现金分期等各类分期业务。消费者只要是用信用卡分期方式进行消费，都可以享受贴息优惠。同时，多家银行强调，办理个人消费贷款和信用卡分期贴息不额外收取服务费用。'}, {'id': '20260822A09ZJO00', 'articletype': '0', 'title': '半年赚了51亿，还是不被看好？', 'pic_style': 0, 'publish_time': '2026-08-22 19:26:44', 'pic_info': {'big_img': ['https://inews.gtimg.com/news_ls/OdA9DUEm0qoDB1wLaZXnXClS9sKCx7778BYRjNJXhpbjoAA_870492/0'], 'small_img': ['https://inews.gtimg.com/news_ls/OdA9DUEm0qoDB1wLaZXnXClS9sKCx7778BYRjNJXhpbjoAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/OdA9DUEm0qoDB1wLaZXnXClS