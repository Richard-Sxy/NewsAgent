img.com/tnews/8c3d00f9/7f36/8c3d00f9-7f36-44a9-82c4-be357b54fe9b.png', 'daytime_url': 'https://new.inews.gtimg.com/tnews/45af77fe/a73d/45af77fe-a73d-42d2-ab80-feaa383611de.png'}}, 'interation_info': {'comment_id': '1260822605074803', 'commet_num': 8, 'read_num': 4952, 'like_num': 21, 'collect_num': 23, 'share_num': 67, 'share_wechat_num': 61}, 'doc_info': {'first_cate_id': '12', 'first_cate_name': 'finance', 'sec_cate_id': '1226', 'sec_cate_name': 'finance_invest'}, 'update_time': '2026-08-22 20:30:05', 'news724_feature': None, 'desc': '本报（chinatimes.net.cn）记者刘诗萌 北京报道7月经济数据发布后的一周内，国常会、发改委密集发声，释放稳投资的强烈信号。8月21日，国务院总理李强主持召开国务院常务会议，听取新一代通信网建设情况汇报，部署进一步清理拖欠企业账款工作。要求坚持应用牵引、适度超前，统筹推进基础网络、空间网络、国际网络、融合网络...', 'safe_control': {'close_all_ad': 0, 'close_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '财经', 'cate1_en_name': 'finance', 'cate1_id': '20003038', 'cate2_name': '宏观经济', 'cate2_id': '20534404'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '最强稳投资信号！国常会部署通信网，发改委两天三会聚焦“六张网”', 'share_subtitle': '本报（chinatimes.net.cn）记者刘诗萌 北京报道7月经济数据发布后的一周内，国常会、发改委密集发声，释放稳投资的强烈信号。8月21日，国务院总理李强主持召开国务院常务会议，听取新一代通信网建设情况汇报，部署进一步清理拖欠企业账款工作。要求坚持应用牵引、适度超前，统筹推进基础网络、空间网络、国际网络、融合网络...'}, 'long_summary': '7月经济数据发布后的一周内，国常会、发改委密集发声，释放稳投资的强烈信号。8月21日，国务院总理李强主持召开国务院常务会议，听取新一代通信网建设情况汇报，部署进一步清理拖欠企业账款工作。要求坚持应用牵引、适度超前，统筹推进基础网络、空间网络、国际网络、融合网络建设；而就在近期，国家发改委也连续在8月19日、20日两天召开了三个会议，分别聚焦“六张网”、民企投资、“两重”建设。这些接连召开的重磅会议，都明显指向了一个共同的靶心——稳投资。'}, {'id': '20260822A09Y1N00', 'articletype': '0', 'title': '额度提高、范围扩大！个人消费贷款贴息“红包”升级，多家银