ent_info': {}, 'user_address': '广东', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': 'U18亚洲杯决赛前瞻：中国能否打破澳不败神话，时隔12年再夺冠？', 'share_subtitle': '北京时间8月23日，U18男篮亚洲杯决赛将于22点正式开打，中国男篮vs澳大利亚男篮。      这是中国男篮时隔12年重返决赛舞台，上一次夺冠还要追溯到2014年。      2014年夺冠庆祝照....'}, 'long_summary': '北京时间8月23日，U18男篮亚洲杯决赛将于22点正式开打，中国男篮vs澳大利亚男篮。这是中国男篮时隔12年重返决赛舞台，上一次夺冠还要追溯到2014年。以孙铭徽，赵睿，周琦，邹雨宸等人为核心，在2014年的多哈完成夺冠。过去三届男篮U18亚洲杯，中国男篮都是夺得第三名。本届的U18男篮亚洲杯至今，中国U18男篮取得5连胜，淘汰赛分别击败了菲律宾，新西兰两支亚洲劲旅晋级决赛。所以本场比赛，对于这一支中国U18男篮，能否打破澳大利亚不败神话的同时，能否时隔12年再度冲冠。'}, {'id': '20260823A09YGH00', 'articletype': '0', 'title': '中国足协：没有证据表明韩国足协对中国足协相关人士提供过“不当招待”行为', 'pic_style': 0, 'publish_time': '2026-08-23 19:09:10', 'pic_info': {'big_img': ['https://inews.gtimg.com/news_ls/O7NML_IEDATe8i-v2gzrtxFlvuBrmjfjx9R-Hg8JwWOwkAA_870492/0'], 'small_img': ['https://inews.gtimg.com/news_ls/O7NML_IEDATe8i-v2gzrtxFlvuBrmjfjx9R-Hg8JwWOwkAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/O7NML_IEDATe8i-v2gzrtxFlvuBrmjfjx9R-Hg8JwWOwkAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/news_ls/O7NML_IEDATe8i-v2gzrtxFlvuBrmjfjx9R-Hg8JwWOwkAA_196130/0', '360x240': 'https://inews.gtimg.com/news_ls/O7NML_IEDATe8i-v2gzrtxFlvuBrmjfjx9R-Hg8JwWOwkAA_360240/0', '330x330': 'https://inews.gtimg.com/news_ls/O7NML_IEDATe8i-v2gzrtxFlvuBrmjfjx9R-Hg8JwWOwkAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/OV8bTdZYue7sFXe_-Tg9mt7Cyvu9XRJ0jV-IJbth0JwsUAA_240240/0'}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260823A09YGH00', 'url': 'https://view.inews.qq.com/a/20260823A09YGH00', 'short_url': 'https://view.inews.qq.com/a/20260823A09YGH00', 'org_url': 'https://view.inews.qq.com/a/20260823A09YGH00'}, 'media_info': {'chl_id': '5564731', 'chl_name': '界面新闻', 'icon': 'ht