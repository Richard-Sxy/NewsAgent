: 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '社会', 'cate1_en_name': 'society', 'cate1_id': '20242855', 'cate2_name': '医药食卫', 'cate2_id': '65998511'}, 'declare': {}, 'pub_info': {'source': '6', 'sub_source': '121'}, 'payment_info': {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '我们调查｜连锁消杀公司长期使用敌敌畏给餐馆消杀，员工无资质配药靠手指量', 'share_subtitle': '近日，新京报我们视频调查发现，一家为绿茶、先启半步颠、凤缘家港式茶点、鱼旨寿司等数十家连锁餐饮企业提供消杀服务的公司，长期使用敌敌畏进行消杀。为规避检查，员工将敌敌畏原液灌入矿泉水瓶并撕掉标签，还使....'}, 'long_summary': '近日，新京报我们视频调查发现，一家为绿茶、先启半步颠、凤缘家港式茶点、鱼旨寿司等数十家连锁餐饮企业提供消杀服务的公司，长期使用敌敌畏进行消杀。为规避检查，员工将敌敌畏原液灌入矿泉水瓶并撕掉标签，还使用“三无”杀鼠剂。有员工坦言：“我们消杀过的餐厅打死也不会去吃的！”在监管部门介入当晚，该公司仍在作业，且表面换合规药品“残杀威”，但残留液体仍检测出敌敌畏成分。目前，当地市监部门正在持续调查中。'}, {'id': '20260821V0860S00', 'articletype': '4', 'title': '许家印被判无期，恒大的故事，全剧终', 'pic_style': 4, 'publish_time': '2026-08-21 15:04:28', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OKIRJivzudosmtPXY_LLGA_lbGZU4ZawMDWf60tv1EpJ8AA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/OKIRJivzudosmtPXY_LLGA_lbGZU4ZawMDWf60tv1EpJ8AA_294195/0'], 'three_img': ['https://inews.gtimg.com/om_ls/OTmcMajSWNG7niLv-i62-VvnfW_AhGIHiXITqwzR495jUAA_150120/0'], 'ls_img_exp_type': '1', 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/OKIRJivzudosmtPXY_LLGA_lbGZU4ZawMDWf60tv1EpJ8AA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/OKIRJivzudosmtPXY_LLGA_lbGZU4ZawMDWf60tv1EpJ8AA_196130/0', '330x330': 'https://inews.gtimg.com/om_ls/OKIRJivzudosmtPXY_LLGA_lbGZU4ZawMDWf60tv1EpJ8AA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/O2X443E245quFuCTaji-B8bZ2DgssHPqpTF_xu3Ado6moAA_240240/0', 'aspect': '1.78', 'pic_first': 'https://puui.qpic.cn/vpic_cover/q3295q6ytyk/q3295q6ytyk_first.jpg/720'}, 'link_info': {'share_url':