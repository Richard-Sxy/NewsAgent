ls/O06WjN8Fy2MVkn2FEaURrvWDsz_jCJh0dwCH-duObw9hUAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/O_xKwe-_XtF2_iZHFxKiH6d9J2QbY-kW4qbFtWuXgzgdYAA_240240/0', 'img_count': 6}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260824A06J1J00', 'url': 'https://new.qq.com/rain/a/20260824A06J1J00', 'short_url': 'https://view.inews.qq.com/a/20260824A06J1J00', 'org_url': 'https://view.inews.qq.com/a/20260824A06J1J00'}, 'media_info': {'chl_id': '23358739', 'chl_name': '天和Auto', 'icon': 'https://inews.gtimg.com/om_ls/OYwEyDmiXj7RexD8f7FGxSpuPstzs5d7H5EBOy-hK7HXEAA_200200/0', 'sicon': 'https://inews.gtimg.com/om_ls/OYwEyDmiXj7RexD8f7FGxSpuPstzs5d7H5EBOy-hK7HXEAA_200200/0', 'mrk': '专注汽车品牌、技术和行业动态解读', 'last_art_update': '0', 'encoded_suid': '8QIf3n9U6IAcsDbY4gE=', 'vip_type': '30011', 'vip_type_new': '30011', 'vip_desc': '汽车领域创作者', 'vip_icon': 'http://inews.gtimg.com/newsapp_ls/0/14876048581/0', 'medal_info': {'type_id': 50, 'medal_id': 70, 'medal_level': 4, 'medal_name': '连续发评90天', 'medal_desc': '连续发表评论90天达成，若中断将重新累计进度', 'night_url': 'https://inews.gtimg.com/newsapp_bt/0/0107172100342_9648/0', 'daytime_url': 'https://inews.gtimg.com/newsapp_bt/0/0107172100342_9648/0'}}, 'interation_info': {'comment_id': '1260824604966375', 'read_num': 91}, 'doc_info': {'first_cate_id': '19', 'first_cate_name': 'auto', 'sec_cate_id': '1901', 'sec_cate_name': 'auto_chanye'}, 'update_time': '2026-08-24 20:30:06', 'news724_feature': None, 'desc': '“要不要去看车展？”“有什么好看呢？是去看那些看起来都差不多的新能源，还是去看车模呢？貌似也没有多少车模了。就这些车还得买门票才能看，还以为是桑塔纳的时代吗？”“无从反驳。”……成都车展：首日的喧嚣和次日的寂静对比强烈，似乎大家都已疲劳和成都的朋友聊了聊关于车展的话题，似乎面对近在咫尺的一年一度的大型车展并不是很感兴趣。理由也是客观的，现在的车展以新能源汽车为主，而新能源汽车的驱动技术基本一致，性能和操控大同小异；甚至于外观设计也在趋同，基本就是迈巴赫流派、保时捷流派、法拉利流派、路虎揽胜和卫士流派，然后再加上埃尔法流派，看多了确实审美疲劳了，而且一些传统品牌还没有来，比如保时捷、捷豹路虎、玛...', 'safe_control': {'close_all_ad': 0, 'close_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '汽车', 'cate1_en_name': 'car', 'cate1_id': '60037744', 'cate2_name': '行业资讯', 'cate2_id': '21595110'}, 'declare': {'id': 2, 'declare': '作者声明：个人观点，仅供参考'}, 'pub_info': {'source': '0', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '安徽', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '成都车展变成卖车场，或许车展已到全面取消门票并改为展销会的时候了', 'share_subtitle': '“要不要去看车展？”“有什么好看呢？是去看那些看起来都差不多的新能源，还是去看车模呢？貌似也没有多少车模了。就这些车还得买门票才能看，还以为是桑塔纳的时代吗？”“无从反驳。”……成都车展：首日的喧嚣和次日的寂静对比强烈，似乎大家都已疲劳和成都的朋友聊了聊关于车展的话题，似乎面对近在咫尺的一年一度的大型车展并不是很感兴趣。理由也是客观的，现在的车展以新能源汽车为主，而新能源汽车的驱动技术基本一致，性能和操控大同小异；甚至于外观设计也在趋同，基本就是迈巴赫流派、保时捷流派、法拉利流派、路虎揽胜和卫士流派，然后再加上埃尔法流派，看多了确实审美疲劳了，而且一些传统品牌还没有来，比如保时捷、捷豹路虎、玛...'}, 'long_summary': '“要不要去看车展？”有什么好看呢？貌似也没有多少车模了。这是成都车展某品牌展台工作人员现场高喊的口号，旁边展台的工作人员在制定展会期间的销售目标，其余展台的工作人员也在热情的推销——展览会彻底沦为展销会了。那么车展还应该收门票吗？或许当汽车展览会开始现场售车的时候，车展就没有收取门票的必要性了；收取门票是为了控制现场人流量，以避免影响现场秩序，可是现在的汽车展会反而需要去吸引更多的人来看展，所以运营模式或应当改一改了。或可以考虑按照比例从成交订单抽成，取消门票，把汽车展览会完全改为汽车展销会。', 'declares': [{'type': 'self_declare', 'text': '作者声明：个人观点，仅供参考', 'self_declare_id': 2}]}, {'id': '20260824V05SG400', 'articletype': '4', 'title': '26.99万起纯电中型SUV，不必随大流， 新世代BMW iX3给了另一种答案', 'pic_style': 4, 'publish_time': '2026-08-24 12:17:39', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OKoY5bRhtlkOMJma7X-ajAzpMDTRO_pv6MpHkYetiojooAA_870492_compress/0'], 'small_img': ['https://inews.gtimg.com/om_ls/Oy08vknsidHBzzu-r23gfnb6bDMGrs0d5qNhbFGBWuZtcAA_294195_compress/0'], 'three_img': ['https://inews.gtimg.com/om_ls/OLeI-3utKF-4dx-CUKo4_YUGa-BuZFjKoH-gm-qB4cCKAAA_150120/0'], 'ls_img_exp_type': '1', 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/OprllnbJNjMVexNRvq1iS07bdMg7bOp3Nup_LR5IWHrFUAA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/OprllnbJNjMVexNRvq1iS07bdMg7bOp3Nup_LR5IWHrFUAA_196130/0', '330x330':