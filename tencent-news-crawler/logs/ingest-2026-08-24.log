ate1_id': '20014398', 'cate2_name': '西甲', 'cate2_id': '7258608'}, 'declare': {}, 'pub_info': {'source': '6', 'sub_source': '121'}, 'payment_info': {}, 'user_address': '广东', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '随着巴萨5-0，赫塔费1-0，马竞2-2，西甲最新积分榜出炉', 'share_subtitle': '8月24日讯，昨夜至今天凌晨，西甲第二轮迎来多场较量，其中马竞主场PK比利亚雷亚尔，赫塔费主场PK桑坦德竞技，埃尔切主场PK巴塞罗那。      最终马竞主场2-2比利亚雷亚尔，普维尔先拔头筹帮助马....'}, 'long_summary': '昨夜至今天凌晨，西甲第二轮迎来多场较量，其中马竞主场PK比利亚雷亚尔，赫塔费主场PK桑坦德竞技，埃尔切主场PK巴塞罗那。赫塔费主场1-0击败桑坦德竞技队，下半场先是桑坦德竞技队马丁罚丢点球，接着于纳尔帮助赫塔费队打入制胜一球。埃尔切主场0-5不敌巴萨，拉菲尼亚上演2球1助的好戏，费尔明梅开二度，戈登助攻梅开二度，阿德耶米1球，埃斯帕特1助攻。至此西甲积分榜发生变化：可以看到巴塞罗那积3分排名第4，赫塔费积3分排名第8，马竞积4分排名第3，比利亚雷亚尔积2分排名第9。'}, {'id': '20260824V09SKI00', 'articletype': '4', 'title': '张宇辰13分3板7助，中国U18男篮亚洲杯亚军', 'pic_style': 4, 'publish_time': '2026-08-24 17:34:19', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/Ot1hE6K73j9WfR4ChCLeZVEov1C3wzl0HTwMYFin3dOv8AA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/Ot1hE6K73j9WfR4ChCLeZVEov1C3wzl0HTwMYFin3dOv8AA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/O9Ya7M8Wb4llTEuceb8xmXxUhpuHctFnPIxksRYrI4Jg0AA_150120/0'], 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/Ot1hE6K73j9WfR4ChCLeZVEov1C3wzl0HTwMYFin3dOv8AA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/Ot1hE6K73j9WfR4ChCLeZVEov1C3wzl0HTwMYFin3dOv8AA_196130/0', '330x330': 'https://inews.gtimg.com/om_ls/Ot1hE6K73j9WfR4ChCLeZVEov1C3wzl0HTwMYFin3dOv8AA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/O1k8PneBirBoVy_m2awxy0t01SCT3LGcW5RPIkFI74LtcAA_240240/0', 'aspect': '1.33', 'pic_first': 'https://puui.qpic.cn/vpic_cover/w3295mueoh5/w3295mueoh5_first.jpg/720'}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260824V09SKI00', 'url': 'https://new.qq.com/rain/a/20260824V09SKI00', 