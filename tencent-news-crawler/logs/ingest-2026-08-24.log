9b.png', 'daytime_url': 'https://new.inews.gtimg.com/tnews/45af77fe/a73d/45af77fe-a73d-42d2-ab80-feaa383611de.png'}}, 'interation_info': {'comment_id': '1260824604853573', 'commet_num': 91, 'read_num': 41287, 'like_num': 137, 'collect_num': 71, 'share_num': 61, 'share_wechat_num': 50}, 'doc_info': {'first_cate_id': '19', 'first_cate_name': 'auto', 'sec_cate_id': '1901', 'sec_cate_name': 'auto_chanye'}, 'update_time': '2026-08-24 20:30:01', 'news724_feature': None, 'desc': '文 | 郭亦非      编辑 | 杨布丁      成都车展静悄悄，只有销售最忙碌。      “车展讲究短平快，效率最重要。”早上刚过九点，FREELANDER神行者展台上，一位销售负责人便开始....', 'safe_control': {'close_all_ad': 0, 'close_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '汽车', 'cate1_en_name': 'car', 'cate1_id': '60037744', 'cate2_name': '行业资讯', 'cate2_id': '21595110'}, 'declare': {}, 'pub_info': {'source': '6', 'sub_source': '121'}, 'payment_info': {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': 4}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '前7月车市跌20.3%，广告消失大佬退场，“卖车第一展”含金量在下滑', 'share_subtitle': '文 | 郭亦非      编辑 | 杨布丁      成都车展静悄悄，只有销售最忙碌。      “车展讲究短平快，效率最重要。”早上刚过九点，FREELANDER神行者展台上，一位销售负责人便开始....'}, 'long_summary': '成都车展静悄悄，只有销售最忙碌。8月21日成都车展首日，上午九点半，作为宝马反击的关键落子，国产新世代BMW iX3预售发布会正式开始，这也是4月份刚上任的宝马大中华区CEO柯睿辰的车展首秀。2026年上半年，国内共有超过500款全口径新车上市，但这依然难挡车市低迷——前7月，国内车市零售量同比下降20.3%。即便成都人爱买车，也难挡大盘车市寒冬。中汽数研统计称，2025年上半年，成都当地卖出了26.17万辆新车，同比下降13.12%，但依然排名全国第一，领先于上海、北京和广州。'}, {'id': '20260824A0A7CU00', 'articletype': '0', 'title': '腾讯阿里参投！小鹏机器人业务首轮融资超9亿美元', 'pic_style': 0, 'publish_time': '2026-08-24 18:01:37', 'pic_info': {'big_img': ['https://inews.gtimg.com/news_ls/OsgRGK4YZl8bK6esn0h1m5y0ZwMCjz_kvrGzGxCFUEg44AA_870492