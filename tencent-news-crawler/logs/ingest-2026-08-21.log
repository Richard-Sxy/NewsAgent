': ''}, 'category': {'cate1_name': '体育', 'cate1_en_name': 'sports', 'cate1_id': '20014398', 'cate2_name': '中国足球', 'cate2_id': '3482284'}, 'declare': {}, 'pub_info': {'source': '6', 'sub_source': '121'}, 'payment_info': {}, 'user_address': '上海', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}, {'type': 'dislike_block', 'name': '不推荐: 许家印', 'id': '2387646'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '许家印10年砸170亿元打造恒大队！李玮锋：他让我在合同上填年薪', 'share_subtitle': '8月20日，68岁的许家印被判无期徒刑，他给中国球迷曾经带来的回忆也彻底飘在了空中。据统计，许家印一共为足球项目花了170亿元，他几乎一手缔造了中国的金元足球。      许家印的足球梦开始于201....'}, 'long_summary': '8月20日，68岁的许家印被判无期徒刑，他给中国球迷曾经带来的回忆也彻底飘在了空中。据统计，许家印一共为足球项目花了170亿元，他几乎一手缔造了中国的金元足球。许家印的足球梦开始于2010年。恒大队冲超成功后，许家印给队内国脚的年薪都涨到了千万级别，且又新签了冯潇霆、张琳芃等人。“他们让我随便填，填完就生效。”李玮锋表示自己曾收到恒大的合同，合同上没有写年薪。据统计，许家印从2010年到2011年累计在足球项目上投入了170亿元，其中140亿元是给恒大队的，30亿元是给恒大足校的。'}, {'id': '20260821V0ADYU00', 'articletype': '4', 'title': '法甲亚洲人还有谁？魏祥鑫能遭遇哪些亚洲德比？| 足球老司机', 'pic_style': 4, 'publish_time': '2026-08-21 17:01:02', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OYWQ2xTPiDrVziCw6sLIg-a8GALQv3fJK2qI_Bb8yW7R4AA_870492/0'], 'small_img': ['https://inews.gtimg.com/om_ls/OYWQ2xTPiDrVziCw6sLIg-a8GALQv3fJK2qI_Bb8yW7R4AA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/OW1pdWpxHz90swy26LgD4xCe7gP-mUqB3QA-3nB6S2arkAA_150120/0'], 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/OYWQ2xTPiDrVziCw6sLIg-a8GALQv3fJK2qI_Bb8yW7R4AA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/OYWQ2xTPiDrVziCw6sLIg-a8GALQv3fJK2qI_Bb8yW7R4AA_196130/0', '330x330': 'https://inews.gtimg.com/om_ls/OYWQ2xTPiDrVziCw6sLIg-a8GALQv3fJK2qI_Bb8yW7R4AA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/OCTcIPuCF7dy5N8tfCdpfdyRdKLx4Oh7w1A8gzOFdATW0AA_240240/0', 'aspect': '1.78', 'pic_first': 'https://puui.qpic.cn/vpic_cover/y12849tvu9d/y1284