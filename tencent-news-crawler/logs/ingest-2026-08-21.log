213_9431/0', 'daytime_url': 'https://inews.gtimg.com/newsapp_bt/0/0107170532213_9431/0'}}, 'interation_info': {'comment_id': '1260821605207551', 'commet_num': 3, 'read_num': 271, 'collect_num': 2, 'share_num': 2, 'share_wechat_num': 2}, 'doc_info': {'first_cate_id': '12', 'first_cate_name': 'finance', 'sec_cate_id': '1216', 'sec_cate_name': 'finance_macroeco'}, 'update_time': '2026-08-21 20:29:55', 'news724_feature': None, 'desc': '8月21日，财政部等3部门联合发布《关于进一步做好财政金融协同促内需政策有关工作的通知》（以下简称《通知》），提出了扩大贴息范围、增加经办机构、适当提高额度等三项举措。年中加码扩内需，业内专家认为，这是财金联动，以有限财政资金撬动信贷，巩固内需复苏，托举下半年经济的重要举措。在21日的国新办新闻发布会上，...', 'safe_control': {'close_all_ad': 0, 'close_all_favorite': 0, 'close_all_rel': 0, 'close_share_pull': 0, 'close_relate_thing': 0, 'close_all_emoticon_comment': 0, 'political_option': '0', 'pc_not_display': ''}, 'category': {'cate1_name': '财经', 'cate1_en_name': 'finance', 'cate1_id': '20003038', 'cate2_name': '宏观经济', 'cate2_id': '20534404'}, 'declare': {}, 'pub_info': {'source': '2', 'sub_source': '0'}, 'payment_info': {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '贴息扩容、消费贷贴息上限提至5000元  三部门加码扩内需政策', 'share_subtitle': '8月21日，财政部等3部门联合发布《关于进一步做好财政金融协同促内需政策有关工作的通知》（以下简称《通知》），提出了扩大贴息范围、增加经办机构、适当提高额度等三项举措。年中加码扩内需，业内专家认为，这是财金联动，以有限财政资金撬动信贷，巩固内需复苏，托举下半年经济的重要举措。在21日的国新办新闻发布会上，...'}, 'long_summary': '8月21日，财政部等3部门联合发布《关于进一步做好财政金融协同促内需政策有关工作的通知》，提出了扩大贴息范围、增加经办机构、适当提高额度等三项举措。年中加码扩内需，业内专家认为，这是财金联动，以有限财政资金撬动信贷，巩固内需复苏，托举下半年经济的重要举措。结合经济发展需要，我们正在继续研究制定财政金融协同的新政策和新举措，并于今年下半年推出。8月21日，财政部等3部门再度从三个方面加码扩内需。单户在单家经办机构可享受中小微企业贷款贴息的贷款规模上限由每年5000万元提高至7500万元。'}, {'id': 'UTR2026073109650500', 'articletype': '116', 'title': '1-7月财政收入累计增速创年内新高，支出端亟待提速', 'pic_style': 0, 'publish_time': '2026-08-21 19:01:23', 'pic_info': {'big_img': ['https://inew