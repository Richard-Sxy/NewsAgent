u_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '从25%到40%：欧洲央行行长拉加德称中国正“稳步向上”直接竞争欧元区领先行业', 'share_subtitle': 'Lagarde: China now competes with the eurozone for 40 per cent of its leading sectors      欧洲央行行长拉加德....'}, 'long_summary': '欧洲央行行长拉加德拉响警报：中国正在“稳步向上游价值链移动”，现已在近40%的欧元区具有比较优势的行业中直接竞争——2000年代初这一比例约为25%。中端制造业的优势——部分得益于相对廉价的能源——也正在被侵蚀。对欧元区和欧盟经济而言，中国是需要果断和迅速回应的最大挑战——欧洲央行行长拉加德拉响了警报：欧洲对中国的优势正在缩小。是现在在近40%的欧元区具有比较优势的行业中，中国直接与欧元区竞争，而2000年代初这一比例约为25%。'}, {'id': '20260820V0EW0500', 'articletype': '4', 'title': '美财政部被迫救市，一场系统性崩溃，比预期早了整整两年', 'pic_style': 4, 'publish_time': '2026-08-20 22:57:13', 'pic_info': {'big_img': ['https://inews.gtimg.com/om_ls/OrNormSPx5_orlC8r1sxz80rZs2BwhJ34jAFWUDc8kxuEAA_870492_compress/0'], 'small_img': ['https://inews.gtimg.com/om_ls/OwOvgk2g9ohmAfN4hvsGB3yOsq-tEo7s2XaJNoOWp-Ct8AA_294195_compress/0'], 'three_img': ['https://inews.gtimg.com/news_ls/OZJ2rX4R0awuavUOx4M2NRyAD1WgiBaPbpZoz_e_9bR6sAA_150120/0'], 'ext': {'640x360': 'https://inews.gtimg.com/om_ls/Oea59ZPcWIXCZ46FL9f4Cizhdsx4YLVj7JHo3vr-gWsGoAA_640360/0', '196x130': 'https://inews.gtimg.com/om_ls/Oea59ZPcWIXCZ46FL9f4Cizhdsx4YLVj7JHo3vr-gWsGoAA_196130/0', '330x330': 'https://inews.gtimg.com/om_ls/Oea59ZPcWIXCZ46FL9f4Cizhdsx4YLVj7JHo3vr-gWsGoAA_330330/0', '480x640': 'https://inews.gtimg.com/om_ls/Oea59ZPcWIXCZ46FL9f4Cizhdsx4YLVj7JHo3vr-gWsGoAA_480640/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/O2G7G0zNIJWHZ14u_aHSziZxAaA8jpUtFrEVdVqvfyul8AA_240240/0', 'aspect': '0.56', 'pic_first': 'https://puui.qpic.cn/vpic_cover/g3294chhqcf/g3294chhqcf_first.jpg/720'}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260820V0EW0500', 'url': 'https://new.qq.com/rain/a/20260820V0EW0500', 'short_url': 'https://view.inews.qq.com/a/20260820V0EW0500', 'org_url': 'https://view.inews.qq.com/a/20260820V0EW0500'}, '