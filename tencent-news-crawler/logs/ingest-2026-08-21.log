_info': {'source': '1', 'sub_source': '117'}, 'payment_info': {}, 'user_address': '北京', 'dislike_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '中国重大突破！马斯克发声', 'share_subtitle': '在我国火箭技术领域近日取得新的突破后，美国太空探索技术公司（SpaceX）创始人兼首席执行官埃隆·马斯克谈及自己2011年的一个预言，并称中国也是人工智能（AI）技术领域的最强竞争者。      8....'}, 'long_summary': '在我国火箭技术领域近日取得新的突破后，美国太空探索技术公司创始人兼首席执行官埃隆·马斯克谈及自己2011年的一个预言，并称中国也是人工智能技术领域的最强竞争者。8月19日，蓝箭航天研制的朱雀三号遥二运载火箭发射升空并成功完成陆地回收。这是中国首次成功实施重复使用运载火箭一子级着陆腿方式陆地可控回收，标志着我国重复使用火箭技术取得重大突破。马斯克随后回复称：“中国也是人工智能领域目前最强的竞争者。”马斯克此前一直关注中国火箭技术的发展，并多次发帖点评。此前报道：重大突破！'}, {'id': '20260821A06GNL00', 'articletype': '0', 'title': '天下没有免费的Deepseek', 'pic_style': 0, 'publish_time': '2026-08-21 13:21:18', 'pic_info': {'big_img': ['https://inews.gtimg.com/news_ls/OUPPW5UmtiQA6bxnLsruUcr7ojcIOQEtp65P8UkiUosGYAA_870492/0'], 'small_img': ['https://inews.gtimg.com/news_ls/OUPPW5UmtiQA6bxnLsruUcr7ojcIOQEtp65P8UkiUosGYAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/OUPPW5UmtiQA6bxnLsruUcr7ojcIOQEtp65P8UkiUosGYAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/news_ls/OUPPW5UmtiQA6bxnLsruUcr7ojcIOQEtp65P8UkiUosGYAA_196130/0', '360x240': 'https://inews.gtimg.com/news_ls/OUPPW5UmtiQA6bxnLsruUcr7ojcIOQEtp65P8UkiUosGYAA_360240/0', '330x330': 'https://inews.gtimg.com/news_ls/OUPPW5UmtiQA6bxnLsruUcr7ojcIOQEtp65P8UkiUosGYAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/OoEh81kjpO24K2uG3mph5ixTrjzfBBSln53l0aL2311oQAA_240240/0', 'img_count': 6}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260821A06GNL00', 'url': 'https://new.qq.com/rain/a/20260821A06GNL00', 'short_url': 'https://view.inews.qq.com/a/20260821A06GNL00', 'org_url': 'https://view.inews.qq.com/a/20260821A06GNL00'}, 'media_info': {'chl_id': '1100', 'chl_name