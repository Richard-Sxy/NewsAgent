_options': [{'menu_id': '0', 'menu_name': '不感兴趣', 'menu_items': [{'type': 'dislike_cp', 'name': '不推荐该作者', 'id': '40033'}, {'type': 'dislike_content', 'name': '减少此类内容', 'id': '40022'}]}], 'cp_info': {'tnews_self_made': -1}, 'flag': {}, 'extra_property': {}, 'share_info': {'share_title': '5个交易日狂飙逾20%，比特币为何极速迈进牛市？', 'share_subtitle': '南方财经 21世纪经济报道记者吴斌 报道 沉寂已久的加密货币市场突然爆发。 8月19日，比特币急速拉升，一度飙升8%，逼近7万美元。随后比特币持续走高，8月21日，比特币上涨近5%，突破7.6万美元。 最近5个交易日，比特币累计上涨超20%，创5月27日以来新高，迈进技术性牛市。 需要注意的是，这次比特币暴涨的核心驱动力并非单...'}, 'long_summary': '沉寂已久的加密货币市场突然爆发。8月19日，比特币急速拉升，一度飙升8%，逼近7万美元。随后比特币持续走高，8月21日，比特币上涨近5%，突破7.6万美元。最近5个交易日，比特币累计上涨超20%，创5月27日以来新高，迈进技术性牛市。需要注意的是，这次比特币暴涨的核心驱动力并非单纯的新增买盘，而是此前积累的大量空头仓位在价格快速上行后集中止损离场，形成明显的被动买盘，进一步放大涨幅。在美国财政部计划将政府债务回购规模扩大一倍以上的消息出炉后，加密货币市场情绪也随之高涨。'}, {'id': '20260821A0BA2F00', 'articletype': '0', 'title': '富达退出中国全资公募基金？外资闯关中国非易事', 'pic_style': 0, 'publish_time': '2026-08-21 17:54:18', 'pic_info': {'big_img': ['https://inews.gtimg.com/news_ls/OdQXx68mI79WXZrFLbH4MGMBddVBCmvCt9XKK6VOg_EBcAA_870492/0'], 'small_img': ['https://inews.gtimg.com/news_ls/OdQXx68mI79WXZrFLbH4MGMBddVBCmvCt9XKK6VOg_EBcAA_294195/0'], 'three_img': ['https://inews.gtimg.com/news_ls/OdQXx68mI79WXZrFLbH4MGMBddVBCmvCt9XKK6VOg_EBcAA_197130/0'], 'ls_img_exp_type': '1', 'ext': {'196x130': 'https://inews.gtimg.com/news_ls/OdQXx68mI79WXZrFLbH4MGMBddVBCmvCt9XKK6VOg_EBcAA_196130/0', '360x240': 'https://inews.gtimg.com/news_ls/OdQXx68mI79WXZrFLbH4MGMBddVBCmvCt9XKK6VOg_EBcAA_360240/0', '330x330': 'https://inews.gtimg.com/news_ls/OdQXx68mI79WXZrFLbH4MGMBddVBCmvCt9XKK6VOg_EBcAA_330330/0'}, 'share_img': 'https://inews.gtimg.com/news_ls/OoiSWFyEVCYEJiLdDOOuVKAtZ8mFdwXk0jESpaXhSGwLwAA_240240/0', 'img_count': 1}, 'link_info': {'share_url': 'https://view.inews.qq.com/a/20260821A0BA2F00', 'url': 'https://view.inews.qq.com/a/20260821A0BA2F00', 'short_url': 'https://view.inews.qq.com/a/20260821A0BA2F00', 'org_url': 'https://view.inews.qq.com/a/20260821A0BA2F00'}, 'media_info': {'chl_id': '2576', 'chl_name': '腾讯财经', 