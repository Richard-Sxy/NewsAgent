EVALUATION_QUESTIONS_PATH=tests/evaluation_questions_v2.json

FASTGPT_QA_DATASET_ID=
FASTGPT_APP_API_KEY=
FASTGPT_APP_ID=

ARTIFACT_PREFIX=news-writing
ARTIFACT_SSE_ALGORITHM=AES256
ARTIFACT_KMS_KEY_ID=
