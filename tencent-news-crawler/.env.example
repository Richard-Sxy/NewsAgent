QA_MAX_RETRY_COUNT=3

DAILY_LIMIT_PER_TOPIC=5
DAILY_MAX_PAGES=3
DAILY_TIMEZONE=Asia/Shanghai
DAILY_QA_LIMIT=20
DAILY_REPORT_DIR=reports
DAILY_EVALUATION_ENABLED=false
