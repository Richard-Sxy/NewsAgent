  "scope": "isolated_synthetic_local_rule_port",
  "runtime": {
    "model_provider": "local",
    "model_route": "native-local-model-v1",
    "prompt_version": "native-conversation-v5",
    "query_enabled": true,
    "query_scope": {
      "name": "query_hot_news",
      "description": "先理解当前问题并校验日期、榜单来源和条件，再查询模拟数仓并执行原有热点分析Workflow；不发布、不审批。今日不等于样本窗口，范围不满足时不会执行取数。",
      "arguments": {
        "question": "完整保留当前用户原问题，2..1000字；不得删除日期、来源或条件，不得携带SQL或身份"
      },
      "scenario_id": "news-ranking",
      "window_start": "2026-10-09T00:00:00+08:00",
      "window_end": "2026-10-09T01:00:00+08:00",
      "coverage_window_start": "2026-09-10T00:00:00+08:00",
      "coverage_window_end": "2026-10-10T00:00:00+08:00",
      "query_policy": {
        "scenario": {
          "id": "news-ranking",
          "name": "30天热点新闻候选排行",
          "description": "在30天热点合成数仓中取有界新闻候选；单次分析只覆盖同一运行的榜单。",
          "result_mode": "ranking",
          "default_sort": "clicks",
          "allowed_sort_metrics": [
            "clicks",
            "ctr",
            "impressions",
            "interactions",
            "hot_score"
          ],
          "allowed_content_types": [
            "article",
            "video"
          ],
          "allowed_categories": [
            "科技",
            "财经",
            "体育",
            "社会"
          ],
          "default_limit": 100,
          "max_limit": 100,
          "sample_questions": [
            "查询点击量最高的前100条新闻",
            "查询点击率最高的前100条视频新闻"
          ]
        },
        "default_limit": 5,
        "max_limit": 100,
        "supported_window_start": "2026-10-09T00:00:00+08:00",
        "supported_window_end": "2026-10-09T01:00:00+08:00",
        "data_watermark": "2026-10-10T00:00:00+08:00",
        "coverage_window_start": "2026-09-10T00:00:00+08:00",
        "coverage_window_end": "2026-10-10T00:00:00+08:00",
        "timezone": "Asia/Shanghai",
        "data_kind": "synthetic",
        "allowed_ranking_sources": [
          "project_computed"
        ]
      },
      "understanding_schema": {
        "$defs": {
          "SqlAssistantIntent": {
            "additionalProperties": false,
            "description": "A model may select approved semantics, never tenant identities or SQL text.",
            "properties": {
              "sort_by": {
                "enum": [
                  "clicks",
                  "ctr",
                  "interactions",
                  "impressions",
                  "hot_score"
                ],
                "title": "Sort By",
                "type": "string"
              },
              "sort_direction": {
                "default": "desc",
                "enum": [
                  "asc",
                  "desc"
                ],
                "title": "Sort Direction",
                "type": "string"
              },
              "content_type": {
                "anyOf": [
                  {
                    "enum": [
                      "article",
                      "video"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Content Type"
              },
              "category": {
                "anyOf": [
                  {
                    "maxLength": 40,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Category"
              },
              "row_limit": {
                "default": 10,
                "maximum": 1000,
                "minimum": 1,
                "title": "Row Limit",
                "type": "integer"
              },
              "explanation": {
                "maxLength": 1000,
                "minLength": 1,
                "title": "Explanation",
                "type": "string"
              }
            },
            "required": [
              "sort_by",
              "explanation"
            ],
            "title": "SqlAssistantIntent",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ready",
              "clarify",
              "unsupported"
            ],
            "title": "Status",
            "type": "string"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/$defs/SqlAssistantIntent"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "time_expression": {
            "default": "sample",
            "enum": [
              "sample",
              "today",
              "yesterday",
              "latest",
              "date"
            ],
            "title": "Time Expression",
            "type": "string"
          },
          "explicit_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Explicit Date"
          },
          "hour_start": {
            "anyOf": [
              {
                "maximum": 23,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hour Start"
          },
          "hour_end": {
            "anyOf": [
              {
                "maximum": 24,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hour End"
          },
          "time_basis": {
            "default": "behavior",
            "enum": [
              "behavior",
              "publication"
            ],
            "title": "Time Basis",
            "type": "string"
          },
          "ranking_source": {
            "default": "unspecified",
            "enum": [
              "project_computed",
              "enterprise_board",
              "unspecified"
            ],
            "title": "Ranking Source",
            "type": "string"
          },
          "unsupported_conditions": {
            "items": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 8,
            "title": "Unsupported Conditions",
            "type": "array"
          }
        },
        "required": [
          "status"
        ],
        "title": "QueryUnderstanding",
        "type": "object"
      }
    },
    "data_analysis": {
      "name": "analyze_hot_news_data",
      "description": "确定性分析同租户已完成榜单；baseline对照已保存参考字段，trend只比较相同筛选规则的两个非重叠等长窗口的新闻交集；不接收代码/SQL/路径/身份",
      "arguments": {
        "run_id": "UUID from current conversation tool results",
        "operation": "overview|distribution|compare|quality|baseline|trend",
        "reference_run_id": "required only for trend; earlier UUID from current conversation tool results",
        "metric": "impressions|clicks|ctr|hot_score|effective_consumptions|interactions|total_duration_seconds"
      },
      "execution_backend": "process",
      "resource_limits": {
        "timeout_seconds": 3.0,
        "max_rows": 200,
        "max_input_bytes": 262144,
        "max_output_bytes": 262144,
        "max_concurrency": 2,
        "memory_mb": 128,
        "os_resource_limits_enforced": true
      }
    }
  },
